                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding SettingsWorkspace.AppearanceStatus}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="2,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="_Views" AutomationProperties.Name="View settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True">
                <StackPanel Margin="34,28">
                    <TextBlock Text="Library views" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Independent sorting, density, filters, and columns for every view" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,22"/>
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Editing view" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding SettingsWorkspace.ViewProfiles}" SelectedItem="{Binding SettingsWorkspace.SelectedViewProfile}" DisplayMemberPath="ViewName" Margin="0,10,0,0" AutomationProperties.Name="View profile to edit"/>
                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Sort by" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding SettingsWorkspace.SortOptions}" SelectedItem="{Binding SettingsWorkspace.SelectedViewProfile.SortBy}" Margin="0,5,0,0" AutomationProperties.Name="View sort field"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Density" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding SettingsWorkspace.DensityOptions}" SelectedItem="{Binding SettingsWorkspace.SelectedViewProfile.Density}" Margin="0,5,0,0" AutomationProperties.Name="View density"/></StackPanel>
                            </Grid>
                            <CheckBox Content="Sort descending" IsChecked="{Binding SettingsWorkspace.SelectedViewProfile.SortDescending}" Margin="0,12,0,0"/>
                            <TextBlock Text="Cover size" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,14,0,0"/><Slider Minimum="80" Maximum="400" SmallChange="4" LargeChange="20" TickFrequency="4" Value="{Binding SettingsWorkspace.SelectedViewProfile.CoverSize}" AutomationProperties.Name="View cover size" AutomationProperties.ItemStatus="{Binding SettingsWorkspace.SelectedViewProfile.CoverSize, StringFormat={}{0:0} pixels}"/>
                            <TextBlock Text="Persistent quick filter" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,14,0,0"/><TextBox Text="{Binding SettingsWorkspace.SelectedViewProfile.QuickFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" AutomationProperties.Name="Persistent quick filter"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Track columns" FontWeight="SemiBold"/>
                            <TextBlock Text="Choose visibility, order, and width. Column options are used by list-based views." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,12"/>
                            <ItemsControl ItemsSource="{Binding SettingsWorkspace.SelectedViewProfile.Columns}">
                                <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat=Show {0} column}"/><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/><TextBox Grid.Column="2" Text="{Binding Width, UpdateSourceTrigger=LostFocus}" Margin="6,0" ToolTip="Width in pixels" AutomationProperties.Name="{Binding Name, StringFormat={}{0} column width in pixels}"/><Button Grid.Column="3" Content="↑" Click="MoveColumnUp_Click" Padding="0" ToolTip="Move left" AutomationProperties.Name="{Binding Name, StringFormat=Move {0} column left}"/><Button Grid.Column="4" Content="↓" Click="MoveColumnDown_Click" Padding="0" ToolTip="Move right" AutomationProperties.Name="{Binding Name, StringFormat=Move {0} column right}"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Style="{StaticResource PrimaryButton}" Content="Apply this view" Click="ApplyViewProfile_Click" Margin="0,0,8,0"/><Button Content="Revert all drafts" Click="RevertViewProfiles_Click" Margin="0,0,8,0"/><Button Content="Reset this view" Click="ResetViewProfile_Click" Margin="0,0,8,0"/><Button Content="Reset all views" Click="ResetAllViews_Click"/></StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="_Diagnostics" AutomationProperties.Name="Diagnostics settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True">
                <StackPanel Margin="34,28">
                    <TextBlock Text="Diagnostics" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Private, local troubleshooting tools" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,22"/>
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Export diagnostics bundle" FontWeight="SemiBold"/>
                            <TextBlock Text="Includes redacted settings, rotating logs, device summaries, version, and database integrity/schema information. It never includes the music database or media files." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,5,0,14"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Export bundle…" Click="ExportDiagnostics_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="Run check" Click="CheckDecoders_Click" Margin="12,0,0,0"/>
                                <StackPanel>
                                    <TextBlock Text="Decoder availability" FontWeight="SemiBold"/>
                                    <TextBlock Text="Uses embedded synthetic audio only. Your library and music files are not opened or changed." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding DecoderCapabilityStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,12,0,8"/>
                            <ItemsControl ItemsSource="{Binding DecoderCapabilities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="85"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Format}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Extensions}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                            <TextBlock Grid.Column="3" Text="{Binding State}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontSize="10"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Safe mode" FontWeight="SemiBold"/>
                            <TextBlock Text="Start with --safe-mode to skip session resume and disable animations/effects. Safe mode is also selected automatically after repeated incomplete startups." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Da_ta" AutomationProperties.Name="Data and recovery settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True">
                <StackPanel Margin="34,28">
                    <TextBlock Text="Data and recovery" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Portable settings and explicit local backups" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,22"/>
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Settings" FontWeight="SemiBold"/>
                            <TextBlock Text="Export or import validated JSON settings. Import never edits the library database or music files." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,5,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="Export settings…" Click="ExportSettings_Click" Margin="0,0,8,0"/>
                                <Button Content="Import settings…" Click="ImportSettings_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="User-data backup" FontWeight="SemiBold"/>
                            <TextBlock Text="Includes settings, playlists, ratings, love state, play history, bookmarks, and the local library index. It does not include or modify audio files." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,5,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="Create backup…" Click="ExportBackup_Click" Margin="0,0,8,0"/>
                                <Button Content="Restore backup…" Click="RestoreBackup_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Reset sections" FontWeight="SemiBold"/>
                            <TextBlock Text="Reset one area without deleting the library database." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,5,0,14"/>
                            <WrapPanel>
                                <Button Content="Appearance" Tag="Appearance" Click="ResetSettings_Click" Margin="0,0,8,8"/>
                                <Button Content="Playback" Tag="Playback" Click="ResetSettings_Click" Margin="0,0,8,8"/>
                                <Button Content="Library sources" Tag="Library" Click="ResetSettings_Click" Margin="0,0,8,8"/>
                                <Button Content="Metadata" Tag="Metadata" Click="ResetSettings_Click" Margin="0,0,8,8"/>
                                <Button Content="Shortcuts" Tag="Shortcuts" Click="ResetSettings_Click" Margin="0,0,8,8"/>
                                <Button Content="Session" Tag="Session" Click="ResetSettings_Click" Margin="0,0,8,8"/>
                                <Button Content="Lyrics" Tag="Lyrics" Click="ResetSettings_Click" Margin="0,0,8,8"/>
                                <Button Content="All settings" Tag="All" Click="ResetSettings_Click" Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="_Shortcuts" AutomationProperties.Name="Shortcut settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True">
                <StackPanel Margin="34,28">
                    <TextBlock Text="Shortcuts" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Rebind in-app and global Windows shortcuts" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,22"/>
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Bindings" FontWeight="SemiBold"/>
                            <TextBlock Text="Click a gesture field and press the desired combination. Global shortcuts require a modifier unless they are media keys." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,12"/>
                            <ItemsControl ItemsSource="{Binding SettingsWorkspace.ShortcutBindings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,7">
                                            <StackPanel>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="74"/><ColumnDefinition Width="74"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{Binding DataContext.SettingsWorkspace.ShortcutActions, RelativeSource={RelativeSource AncestorType=Window}}" SelectedValuePath="Action" DisplayMemberPath="Label" SelectedValue="{Binding Action}" Margin="0,0,8,0" AutomationProperties.Name="Shortcut action"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Gesture}" PreviewKeyDown="ShortcutGesture_PreviewKeyDown" Margin="0,0,8,0" ToolTip="Focus and press a shortcut" AutomationProperties.Name="Shortcut gesture" AutomationProperties.HelpText="Focus this field and press the desired key combination."/>
                                                    <CheckBox Grid.Column="2" Content="Global" IsChecked="{Binding Global}" VerticalAlignment="Center"/>
                                                    <CheckBox Grid.Column="3" Content="Enabled" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="4" Content="×" Click="RemoveShortcut_Click" Padding="0" ToolTip="Remove binding" AutomationProperties.Name="Remove shortcut binding"/>
                                                </Grid>
                                                <TextBlock Text="{Binding ValidationText}" Foreground="#FFFF8F8F" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Add binding" Click="AddShortcut_Click" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0"><StackPanel><TextBlock Text="Mouse navigation" FontWeight="SemiBold"/><TextBlock Text="Mouse4 goes back and Mouse5 goes forward through view and collection history." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                    <TextBlock Text="{Binding SettingsWorkspace.ShortcutStatus}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="2,12,0,0"/>
                    <WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource PrimaryButton}" Content="Apply shortcuts" Click="ApplyShortcuts_Click" Margin="0,0,8,8"/><Button Content="Revert" Click="RevertShortcuts_Click" Margin="0,0,8,8"/><Button Content="Default preset" Click="ResetShortcuts_Click" Margin="0,0,8,8"/><Button Content="Import preset..." Click="ImportShortcuts_Click" Margin="0,0,8,8"/><Button Content="Export preset..." Click="ExportShortcuts_Click" Margin="0,0,8,8"/></WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Ab_out" AutomationProperties.Name="About Dextromethorphan">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True">
                <StackPanel Margin="34,28">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24"><Image Source="Assets/Brand/dextromethorphan-symbol.png" Width="68" Height="68"/><StackPanel Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock Text="dextromethorphan" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="MUSIC PLAYER" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="1,4,0,0"/></StackPanel></StackPanel>
                    <Border Style="{StaticResource Card}" Padding="18">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="Version" Foreground="{DynamicResource TextMutedBrush}"/><TextBlock Grid.Column="1" Text="{Binding SettingsWorkspace.ApplicationVersion}"/>
                            <TextBlock Grid.Row="1" Text="Build" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SettingsWorkspace.BuildCommit}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="2" Text="Runtime" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SettingsWorkspace.RuntimeDescription}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="3" Text="Updates" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SettingsWorkspace.UpdateStatus}" Margin="0,8,0,0"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0"><StackPanel><TextBlock Text="Privacy" FontWeight="SemiBold"/><TextBlock Text="{Binding SettingsWorkspace.PrivacySummary}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                    <WrapPanel Margin="0,12,0,0"><Button Content="Open app data" Click="OpenAppData_Click" Margin="0,0,8,8"/><Button Content="Open logs" Click="OpenLogs_Click" Margin="0,0,8,8"/><Button Content="Open licenses" Click="OpenLicenses_Click" Margin="0,0,8,8"/><Button Content="Project on GitHub" Click="OpenProject_Click" Margin="0,0,8,8"/></WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>

            <Border Grid.Row="1"
                    Panel.ZIndex="120"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,18"
                    Padding="12,8,8,8"
                    CornerRadius="10"
                    BorderThickness="1"
                    Background="{DynamicResource SurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    Effect="{StaticResource SoftShadow}"
                    Visibility="{Binding IsUserNoticeVisible, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="{Binding ActiveToast.AutomationText}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ActiveToast.Glyph}"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="2,0,9,0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ActiveToast.Message}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="2"
                            Width="30"
                            Height="30"
                            Margin="10,0,0,0"
                            Style="{StaticResource IconButton}"
                            Content="&#xE711;"
                            Command="{Binding DismissNoticeCommand}"
                            ToolTip="Dismiss notification"
                            AutomationProperties.Name="Dismiss notification"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
