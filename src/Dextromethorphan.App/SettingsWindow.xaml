<Window x:Class="Dextromethorphan.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Dextromethorphan.App.UI"
        Title="Dextromethorphan settings" Width="820" Height="640" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Item" Margin="8,2" Padding="14,11" CornerRadius="8" Background="Transparent">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="{TemplateBinding Background}"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                                <StackPanel><TextBlock Text="SETTINGS" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="22,22,0,12"/><StackPanel IsItemsHost="True"/></StackPanel>
                            </Border>
                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl>
        <TabItem Header="Audio">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True">
                <StackPanel Margin="34,28">
                    <TextBlock Text="Audio output" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="A separate signal-path profile is saved for every Windows endpoint." Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,22"/>

                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Output device" FontWeight="SemiBold"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}" DisplayMemberPath="Name" SelectionChanged="OutputDevice_SelectionChanged"/>
                                <Button Grid.Column="1" Content="Refresh" Click="RefreshOutputs_Click" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{Binding OutputProfileStatus}" Foreground="{StaticResource AccentBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Endpoint profile" FontWeight="SemiBold"/>
                            <TextBlock Text="Changes are applied only after Save profile." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"><TextBlock Text="WASAPI mode" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding WasapiModes}" SelectedItem="{Binding OutputProfile.Mode}" Margin="0,5,0,10"/></StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Text="Event buffer (ms)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/><TextBox Text="{Binding OutputProfile.BufferMilliseconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/></StackPanel>

                                <StackPanel Grid.Row="1"><TextBlock Text="Sample-rate policy" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding SampleRatePolicies}" SelectedItem="{Binding OutputProfile.SampleRatePolicy}" Margin="0,5,0,10"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Fixed sample rate" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding OutputProfile.PreferredSampleRate}" Margin="0,5,0,10"/></StackPanel>

                                <StackPanel Grid.Row="2"><TextBlock Text="Bit-depth policy" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding BitDepthPolicies}" SelectedItem="{Binding OutputProfile.BitDepthPolicy}" Margin="0,5,0,10"/></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Fixed bit depth" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding BitDepths}" SelectedItem="{Binding OutputProfile.PreferredBitDepth}" Margin="0,5,0,10"/></StackPanel>

                                <StackPanel Grid.Row="3"><TextBlock Text="Channel policy" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding ChannelPolicies}" SelectedItem="{Binding OutputProfile.ChannelPolicy}" Margin="0,5,0,10"/></StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2"><TextBlock Text="Failure fallback" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding OutputFallbackPolicies}" SelectedItem="{Binding OutputProfile.FallbackPolicy}" Margin="0,5,0,10"/></StackPanel>

                                <StackPanel Grid.Row="4"><TextBlock Text="Volume control" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding VolumeControlModes}" SelectedItem="{Binding OutputProfile.VolumeControl}" Margin="0,5,0,10"/></StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Text="DSD mode" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding DsdModes}" SelectedItem="{Binding OutputProfile.DsdMode}" Margin="0,5,0,10"/></StackPanel>

                                <StackPanel Grid.Row="5"><TextBlock Text="Recovery attempts" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/><TextBox Text="{Binding OutputProfile.RecoveryMaximumAttempts, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/></StackPanel>
                                <StackPanel Grid.Row="5" Grid.Column="2"><TextBlock Text="Initial retry delay (ms)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/><TextBox Text="{Binding OutputProfile.RecoveryInitialDelayMilliseconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/></StackPanel>

                                <StackPanel Grid.Row="6">
                                    <CheckBox Content="Prefer direct bit-perfect path" IsChecked="{Binding OutputProfile.PreferBitPerfect}"/>
                                    <TextBlock Text="Software volume, ReplayGain, fades, crossfade, and tempo processing require DSP." Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="24,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="6" Grid.Column="2"><TextBlock Text="Per-output crossfade (seconds)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/><Slider Minimum="0" Maximum="10" Value="{Binding OutputProfile.CrossfadeSeconds}" Margin="0,5,0,0"/></StackPanel>
                            </Grid>
                            <Button Style="{StaticResource PrimaryButton}" Content="Save profile" Click="SaveOutputProfile_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Reported capabilities" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding OutputMixFormat, StringFormat=Shared mix: {0}}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,5,0,2"/>
                            <TextBlock Text="{Binding SupportsEventDrivenExclusive, StringFormat=Event-driven exclusive: {0}}" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                            <TextBlock Text="Accepted exclusive PCM formats" FontWeight="SemiBold" Margin="0,14,0,8"/>
                            <ItemsControl ItemsSource="{Binding SupportedExclusiveFormats}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource AccentSoftBrush}" CornerRadius="7" Padding="8,5" Margin="0,0,6,6"><TextBlock Text="{Binding}" FontSize="9" Foreground="{StaticResource AccentBrush}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0"><StackPanel><TextBlock Text="Current volume" FontWeight="SemiBold"/><TextBlock Text="Software mode never changes the Windows endpoint volume. Hardware mode does so only when explicitly selected for this output." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12"/><Slider Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"/></StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Playback">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True"><StackPanel Margin="34,28"><TextBlock Text="Playback" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Transition and signal-path behavior" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,22"/><Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Bit-perfect mode" FontWeight="SemiBold"/><TextBlock Text="Exclusive WASAPI with no DSP bypasses the shared Windows mixer. ReplayGain, crossfade, speed, pitch, fades, and software volume deliberately use the DSP path." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Library">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True">
                <StackPanel Margin="34,28">
                    <TextBlock Text="Library" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Local, mounted, and SMB music sources" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,22"/>
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Folder watching and indexed metadata are enabled."/>
                            <TextBlock Text="Use Add music folder in the main window to add another source." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,14"/>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Content="Rescan library" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding LibrarySources}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,0,0">
                                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#FFFFB454"/><Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Fill" Value="#FF69D39B"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                            <TextBlock Text="{Binding Root}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Error}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding LastSuccessfulScan, StringFormat={}{0:g}}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LastSuccessfulScan}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Kind}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding IsWatching, StringFormat={}Watcher: {0}}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding TrackCount, StringFormat={}{0:N0} tracks}" Foreground="{StaticResource AccentBrush}" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Artwork cache" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ArtworkCacheStatus}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Slider Minimum="64" Maximum="4096" TickFrequency="64" IsSnapToTickEnabled="True" Value="{Binding ArtworkCacheMegabytes}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ArtworkCacheLimitText}" Foreground="{StaticResource TextMutedBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Clearing removes originals and thumbnails. Rebuild reads embedded covers from every available library file." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,9,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding RebuildArtworkCacheCommand}" Content="Rebuild cache" Margin="0,0,8,0"/>
                                <Button Command="{Binding ClearArtworkCacheCommand}" Content="Clear cache" Margin="0,0,8,0"/>
                                <Button Command="{Binding RefreshArtworkCacheCommand}" Content="Refresh size"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Duplicate analysis" FontWeight="SemiBold"/>
                            <TextBlock Text="A read-only, cancellable SHA-256 comparison runs only for same-size available files. Nothing is removed automatically." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,10"/>
                            <TextBlock Text="{Binding DuplicateScanStatus}" Foreground="{StaticResource AccentBrush}" FontSize="10" Margin="0,0,0,12"/>
                            <Button Content="Find content duplicates" Click="FindDuplicates_Click" HorizontalAlignment="Left"/>
                            <ItemsControl ItemsSource="{Binding DuplicateGroups}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0FFFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Tracks.Count, StringFormat={}{0} identical files}" FontWeight="SemiBold"/>
                                                <ItemsControl ItemsSource="{Binding Tracks}" Margin="0,5,0,0">
                                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Path}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis"/></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Appearance">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True"><StackPanel Margin="34,28"><TextBlock Text="Appearance" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Library density and panel behavior" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,22"/><Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Collection cover size" FontWeight="SemiBold"/><Slider Minimum="110" Maximum="210" Value="{Binding AlbumTileSize}" Margin="0,12,0,6"/><CheckBox Content="Show queue panel" IsChecked="{Binding QueueVisible}" Margin="0,14,0,0"/><CheckBox Content="Use interface animations" IsChecked="{Binding AnimationsEnabled}" Margin="0,12,0,0"/><TextBlock Text="Animations use WPF composition transforms only and can be disabled instantly." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="24,5,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Diagnostics">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True">
                <StackPanel Margin="34,28">
                    <TextBlock Text="Diagnostics" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Private, local troubleshooting tools" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,22"/>
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Export diagnostics bundle" FontWeight="SemiBold"/>
                            <TextBlock Text="Includes redacted settings, rotating logs, device summaries, version, and database integrity/schema information. It never includes the music database or media files." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,14"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Export bundle…" Click="ExportDiagnostics_Click" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="Run check" Click="CheckDecoders_Click" Margin="12,0,0,0"/>
                                <StackPanel>
                                    <TextBlock Text="Decoder availability" FontWeight="SemiBold"/>
                                    <TextBlock Text="Uses embedded synthetic audio only. Your library and music files are not opened or changed." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding DecoderCapabilityStatus}" Foreground="{StaticResource AccentBrush}" FontSize="10" Margin="0,12,0,8"/>
                            <ItemsControl ItemsSource="{Binding DecoderCapabilities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="85"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Format}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Extensions}" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                            <TextBlock Grid.Column="3" Text="{Binding State}" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" FontSize="10"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Safe mode" FontWeight="SemiBold"/>
                            <TextBlock Text="Start with --safe-mode to skip session resume and disable animations/effects. Safe mode is also selected automatically after repeated incomplete startups." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Data">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True">
                <StackPanel Margin="34,28">
                    <TextBlock Text="Data and recovery" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Portable settings and explicit local backups" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,22"/>
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Settings" FontWeight="SemiBold"/>
                            <TextBlock Text="Export or import validated JSON settings. Import never edits the library database or music files." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="Export settings…" Click="ExportSettings_Click" Margin="0,0,8,0"/>
                                <Button Content="Import settings…" Click="ImportSettings_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="User-data backup" FontWeight="SemiBold"/>
                            <TextBlock Text="Includes settings, playlists, ratings, love state, play history, bookmarks, and the local library index. It does not include or modify audio files." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="Create backup…" Click="ExportBackup_Click" Margin="0,0,8,0"/>
                                <Button Content="Restore backup…" Click="RestoreBackup_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Reset sections" FontWeight="SemiBold"/>
                            <TextBlock Text="Reset one area without deleting the library database." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,14"/>
                            <WrapPanel>
                                <Button Content="Appearance" Tag="Appearance" Click="ResetSettings_Click" Margin="0,0,8,8"/>
                                <Button Content="Playback" Tag="Playback" Click="ResetSettings_Click" Margin="0,0,8,8"/>
                                <Button Content="Library sources" Tag="Library" Click="ResetSettings_Click" Margin="0,0,8,8"/>
                                <Button Content="Shortcuts" Tag="Shortcuts" Click="ResetSettings_Click" Margin="0,0,8,8"/>
                                <Button Content="Session" Tag="Session" Click="ResetSettings_Click" Margin="0,0,8,8"/>
                                <Button Content="All settings" Tag="All" Click="ResetSettings_Click" Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Shortcuts">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True"><StackPanel Margin="34,28"><TextBlock Text="Shortcuts" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Keyboard, media-key, and mouse navigation" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,22"/><Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Mouse4" FontWeight="SemiBold"/><TextBlock Text="Go back through view and collection history" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,12"/><TextBlock Text="Mouse5" FontWeight="SemiBold"/><TextBlock Text="Go forward through view and collection history" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
