                                       IsChecked="{Binding SettingsWorkspace.QueuePanelCompact}"
                                       Margin="0,10,0,0"
                                       AutomationProperties.HelpText="Keeps the queue available without occupying the full panel width."/>
                            <CheckBox Content="Use interface animations" IsChecked="{Binding AnimationsEnabled}" Margin="0,10,0,0"/>
