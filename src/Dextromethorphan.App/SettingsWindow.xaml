<Window x:Class="Dextromethorphan.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Dextromethorphan.App.UI"
        Title="Dextromethorphan settings" Width="820" Height="640" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Item" Margin="8,2" Padding="14,11" CornerRadius="8" Background="Transparent">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="{TemplateBinding Background}"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                                <StackPanel><TextBlock Text="SETTINGS" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="22,22,0,12"/><StackPanel IsItemsHost="True"/></StackPanel>
                            </Border>
                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl>
        <TabItem Header="Audio">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True">
                <StackPanel Margin="34,28">
                    <TextBlock Text="Audio output" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="WASAPI endpoints detected on this computer" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,22"/>
                    <ItemsControl ItemsSource="{Binding OutputDevices}">
                        <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding State}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="1" CornerRadius="9" Background="{StaticResource AccentSoftBrush}" Padding="9,4" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="DEFAULT" FontSize="9" Foreground="{StaticResource AccentBrush}"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0"><StackPanel><TextBlock Text="Software volume" FontWeight="SemiBold"/><TextBlock Text="DSP volume is independent from the Windows mixer." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,12"/><Slider Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"/></StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Playback">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True"><StackPanel Margin="34,28"><TextBlock Text="Playback" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Transition and signal-path behavior" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,22"/><Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Bit-perfect mode" FontWeight="SemiBold"/><TextBlock Text="Exclusive WASAPI with no DSP bypasses the shared Windows mixer. ReplayGain, crossfade, speed, pitch, fades, and software volume deliberately use the DSP path." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Library">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True">
                <StackPanel Margin="34,28">
                    <TextBlock Text="Library" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Local, mounted, and SMB music sources" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,22"/>
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Folder watching and indexed metadata are enabled."/>
                            <TextBlock Text="Use Add music folder in the main window to add another source." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,14"/>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Content="Rescan library" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Artwork cache" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ArtworkCacheStatus}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Slider Minimum="64" Maximum="4096" TickFrequency="64" IsSnapToTickEnabled="True" Value="{Binding ArtworkCacheMegabytes}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ArtworkCacheLimitText}" Foreground="{StaticResource TextMutedBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Clearing removes originals and thumbnails. Rebuild reads embedded covers from every available library file." TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,9,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding RebuildArtworkCacheCommand}" Content="Rebuild cache" Margin="0,0,8,0"/>
                                <Button Command="{Binding ClearArtworkCacheCommand}" Content="Clear cache" Margin="0,0,8,0"/>
                                <Button Command="{Binding RefreshArtworkCacheCommand}" Content="Refresh size"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Appearance">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True"><StackPanel Margin="34,28"><TextBlock Text="Appearance" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Library density and panel behavior" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,22"/><Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Collection cover size" FontWeight="SemiBold"/><Slider Minimum="110" Maximum="210" Value="{Binding AlbumTileSize}" Margin="0,12,0,6"/><CheckBox Content="Show queue panel" IsChecked="{Binding QueueVisible}" Margin="0,14,0,0"/><CheckBox Content="Use interface animations" IsChecked="{Binding AnimationsEnabled}" Margin="0,12,0,0"/><TextBlock Text="Animations use WPF composition transforms only and can be disabled instantly." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="24,5,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Shortcuts">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True"><StackPanel Margin="34,28"><TextBlock Text="Shortcuts" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Keyboard, media-key, and mouse navigation" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,22"/><Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Mouse4" FontWeight="SemiBold"/><TextBlock Text="Go back through view and collection history" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,12"/><TextBlock Text="Mouse5" FontWeight="SemiBold"/><TextBlock Text="Go forward through view and collection history" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
