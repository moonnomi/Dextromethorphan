                                <Button Width="30" Height="30" Margin="0,0,8,0" Tag="#55C2FF" Click="AccentSwatch_Click" Background="#55C2FF" ToolTip="Sky" AutomationProperties.Name="Use sky accent"/>
                                <Button Width="30" Height="30" Margin="0,0,8,0" Tag="#69D39B" Click="AccentSwatch_Click" Background="#69D39B" ToolTip="Mint" AutomationProperties.Name="Use mint accent"/>
                                <Button Width="30" Height="30" Margin="0,0,8,0" Tag="#FF8A67" Click="AccentSwatch_Click" Background="#FF8A67" ToolTip="Coral" AutomationProperties.Name="Use coral accent"/>
                                <Button Width="30" Height="30" Tag="#D18CFF" Click="AccentSwatch_Click" Background="#D18CFF" ToolTip="Violet" AutomationProperties.Name="Use violet accent"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Typography and surfaces" FontWeight="SemiBold"/>
                            <TextBlock Text="Interface font" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,12,0,0"/><ComboBox ItemsSource="{Binding SettingsWorkspace.FontFamilies}" SelectedItem="{Binding SettingsWorkspace.FontFamily}" IsEditable="True" IsTextSearchEnabled="True" MaxDropDownHeight="300" Margin="0,5,0,0" AutomationProperties.Name="Interface font family"/>
                            <TextBlock Text="Interface font size" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,14,0,0"/><Slider Minimum="11" Maximum="20" SmallChange="0.5" LargeChange="2" TickFrequency="0.5" Value="{Binding SettingsWorkspace.InterfaceFontSize}" AutomationProperties.Name="Interface font size" AutomationProperties.ItemStatus="{Binding SettingsWorkspace.InterfaceFontSize, StringFormat={}{0:0.0} points}"/>
                            <TextBlock Text="Window surface opacity" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,14,0,0"/><Slider Minimum="0.72" Maximum="1" SmallChange="0.02" LargeChange="0.1" TickFrequency="0.02" Value="{Binding SettingsWorkspace.BackgroundOpacity}" AutomationProperties.Name="Window surface opacity" AutomationProperties.ItemStatus="{Binding SettingsWorkspace.BackgroundOpacity, StringFormat={}{0:P0}}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                             <TextBlock Text="Shell behavior" FontWeight="SemiBold"/>
                             <TextBlock Text="Queue panel width" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,12,0,0"/><Slider Minimum="280" Maximum="520" SmallChange="10" LargeChange="40" TickFrequency="10" Value="{Binding SettingsWorkspace.QueuePanelWidth}" AutomationProperties.Name="Queue panel width" AutomationProperties.ItemStatus="{Binding SettingsWorkspace.QueuePanelWidthText}"/><TextBlock Text="{Binding SettingsWorkspace.QueuePanelWidthText}" Foreground="{DynamicResource AccentBrush}" FontSize="10"/>
