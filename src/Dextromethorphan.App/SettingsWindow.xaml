<Window x:Class="Dextromethorphan.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Dextromethorphan.App.UI"
        Title="Dextromethorphan settings" Width="980" Height="720" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown"
        Closing="SettingsWindow_Closing"
        KeyboardNavigation.TabNavigation="Continue"
        KeyboardNavigation.ControlTabNavigation="Continue"
        AutomationProperties.Name="Dextromethorphan settings">
    <Window.Resources>
        <ResourceDictionary>
            <!-- Settings can also be opened during recovery/safe-mode startup,
                 before the main window has materialized its resource scope. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UI/Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Item" Margin="8,2" Padding="14,11" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            </Style>
            <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="{TemplateBinding Background}"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                                <StackPanel><TextBlock Text="SETTINGS" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="22,22,0,12"/><StackPanel IsItemsHost="True"/></StackPanel>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="10"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="SettingsTitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                        <Image Source="Assets/Brand/dextromethorphan-symbol-compact.png"
                               Width="25" Height="25" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Settings" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="12,7">
                        <TextBox x:Name="SettingsSearchBox"
                                 TextChanged="SettingsSearchBox_TextChanged"
                                 Padding="34,7,10,7"
                                 ToolTip="Search settings (Ctrl+F)"
                                 AutomationProperties.Name="Search settings"/>
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE721;" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                        <Popup x:Name="SettingsSearchPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=SettingsSearchBox}" StaysOpen="False" AllowsTransparency="True">
                            <Border Width="320" MaxHeight="360" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="6">
                                <ListBox x:Name="SettingsSearchResults" Background="Transparent" BorderThickness="0" MouseDoubleClick="SettingsSearchResult_Click" AutomationProperties.Name="Settings search results" AutomationProperties.HelpText="Use arrow keys to choose a result and Enter to open its settings page.">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="SettingsSearchResult_Click" HorizontalContentAlignment="Stretch" Padding="10,8" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}">
                                                <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WindowButton}" Height="46" Click="SettingsMinimize_Click" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize settings"/>
                        <Button Style="{StaticResource WindowButton}" Height="46" Click="SettingsMaximize_Click" Content="&#xE922;" ToolTip="Maximize" AutomationProperties.Name="Maximize or restore settings"/>
                        <Button Style="{StaticResource CloseWindowButton}" Height="46" Click="SettingsClose_Click" Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close settings"/>
                    </StackPanel>
                </Grid>
            </Border>

    <TabControl x:Name="SettingsTabs" Grid.Row="1" KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.Name="Settings categories">
        <TabItem Header="_Audio" AutomationProperties.Name="Audio settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True">
                <StackPanel Margin="34,28">
                    <TextBlock Text="Audio output" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="A separate signal-path profile is saved for every Windows endpoint." Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,22"/>

                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Output device" FontWeight="SemiBold"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding OutputDevices}"
                                          SelectedItem="{Binding SelectedOutputDevice}"
                                          AutomationProperties.Name="Output device"
                                          AutomationProperties.HelpText="Choose the Windows audio endpoint whose profile you want to inspect or edit."
                                          SelectionChanged="OutputDevice_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="_Refresh" AutomationProperties.Name="Refresh output devices" Click="RefreshOutputs_Click" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{Binding OutputProfileStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Endpoint profile" FontWeight="SemiBold"/>
                            <TextBlock Text="Changes are applied only after Save profile." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,4,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"><TextBlock Text="WASAPI mode" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding WasapiModes}" SelectedItem="{Binding OutputProfile.Mode}" Margin="0,5,0,10" AutomationProperties.Name="WASAPI mode"/></StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2"><TextBlock Text="Event buffer (ms)" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><TextBox Text="{Binding OutputProfile.BufferMilliseconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" AutomationProperties.Name="Event buffer milliseconds"/></StackPanel>

                                <StackPanel Grid.Row="1"><TextBlock Text="Sample-rate policy" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding SampleRatePolicies}" SelectedItem="{Binding OutputProfile.SampleRatePolicy}" Margin="0,5,0,10" AutomationProperties.Name="Sample rate policy"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="Fixed sample rate" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding SampleRates}" SelectedItem="{Binding OutputProfile.PreferredSampleRate}" Margin="0,5,0,10" AutomationProperties.Name="Fixed sample rate"/></StackPanel>

                                <StackPanel Grid.Row="2"><TextBlock Text="Bit-depth policy" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding BitDepthPolicies}" SelectedItem="{Binding OutputProfile.BitDepthPolicy}" Margin="0,5,0,10" AutomationProperties.Name="Bit depth policy"/></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Fixed bit depth" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding BitDepths}" SelectedItem="{Binding OutputProfile.PreferredBitDepth}" Margin="0,5,0,10" AutomationProperties.Name="Fixed bit depth"/></StackPanel>

                                <StackPanel Grid.Row="3"><TextBlock Text="Channel policy" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding ChannelPolicies}" SelectedItem="{Binding OutputProfile.ChannelPolicy}" Margin="0,5,0,10" AutomationProperties.Name="Channel policy"/></StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2"><TextBlock Text="Failure fallback" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding OutputFallbackPolicies}" SelectedItem="{Binding OutputProfile.FallbackPolicy}" Margin="0,5,0,10" AutomationProperties.Name="Output failure fallback"/></StackPanel>

                                <StackPanel Grid.Row="4"><TextBlock Text="Volume control" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding VolumeControlModes}" SelectedItem="{Binding OutputProfile.VolumeControl}" Margin="0,5,0,10" AutomationProperties.Name="Volume control mode"/></StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Text="DSD mode" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding DsdModes}" SelectedItem="{Binding OutputProfile.DsdMode}" Margin="0,5,0,10" AutomationProperties.Name="DSD mode"/></StackPanel>

                                <StackPanel Grid.Row="5"><TextBlock Text="Recovery attempts" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><TextBox Text="{Binding OutputProfile.RecoveryMaximumAttempts, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" AutomationProperties.Name="Maximum recovery attempts"/></StackPanel>
                                <StackPanel Grid.Row="5" Grid.Column="2"><TextBlock Text="Initial retry delay (ms)" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><TextBox Text="{Binding OutputProfile.RecoveryInitialDelayMilliseconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" AutomationProperties.Name="Initial retry delay milliseconds"/></StackPanel>

                                <StackPanel Grid.Row="6">
                                    <CheckBox Content="Prefer direct bit-perfect path" IsChecked="{Binding OutputProfile.PreferBitPerfect}"/>
                                    <TextBlock Text="Software volume, ReplayGain, fades, crossfade, and tempo processing require DSP." Foreground="{DynamicResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="24,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Row="6" Grid.Column="2"><TextBlock Text="Per-output crossfade (seconds)" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><Slider Minimum="0" Maximum="10" SmallChange="0.25" LargeChange="1" Value="{Binding OutputProfile.CrossfadeSeconds}" Margin="0,5,0,0" AutomationProperties.Name="Per-output crossfade" AutomationProperties.ItemStatus="{Binding OutputProfile.CrossfadeSeconds, StringFormat={}{0:0.##} seconds}" AutomationProperties.HelpText="Use Arrow keys for quarter-second steps and Page Up or Page Down for one-second steps."/></StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Apply profile" Click="SaveOutputProfile_Click" Margin="0,0,8,0"/>
                                <Button Content="Revert" Click="RevertOutputProfile_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Reported capabilities" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding OutputMixFormat, StringFormat=Shared mix: {0}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,5,0,2"/>
                            <TextBlock Text="{Binding SupportsEventDrivenExclusive, StringFormat=Event-driven exclusive: {0}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                            <TextBlock Text="Accepted exclusive PCM formats" FontWeight="SemiBold" Margin="0,14,0,8"/>
                            <ItemsControl ItemsSource="{Binding SupportedExclusiveFormats}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="8,5" Margin="0,0,6,6"><TextBlock Text="{Binding}" FontSize="9" Foreground="{DynamicResource AccentBrush}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0"><StackPanel><TextBlock Text="Current volume" FontWeight="SemiBold"/><TextBlock Text="Software mode never changes the Windows endpoint volume. Hardware mode does so only when explicitly selected for this output." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12"/><Slider Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1" Value="{Binding Volume, Mode=TwoWay}" AutomationProperties.Name="Current volume" AutomationProperties.ItemStatus="{Binding Volume, StringFormat={}{0:P0}}" AutomationProperties.HelpText="Use Arrow keys for one-percent steps and Page Up or Page Down for ten-percent steps."/></StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="_Playback" AutomationProperties.Name="Playback settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True">
                <StackPanel Margin="34,28">
                    <TextBlock Text="Playback" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Transition and signal-path behavior" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,22"/>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Session and queue" FontWeight="SemiBold"/>
                            <CheckBox Content="Resume the previous session at startup" IsChecked="{Binding SettingsWorkspace.ResumeOnStartup}" Margin="0,12,0,0"/>
                            <CheckBox Content="Resume saved per-track bookmarks" IsChecked="{Binding SettingsWorkspace.ResumeTrackBookmarks}" Margin="0,9,0,0"/>
                            <CheckBox Content="Stop after the current track" IsChecked="{Binding SettingsWorkspace.StopAfterCurrent}" Margin="0,9,0,0"/>
                            <CheckBox Content="Stop at the end of the queue" IsChecked="{Binding SettingsWorkspace.StopAfterQueue}" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Transitions" FontWeight="SemiBold"/>
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Default mode" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding SettingsWorkspace.TransitionModes}" SelectedItem="{Binding SettingsWorkspace.TransitionMode}" Margin="0,5,0,0" AutomationProperties.Name="Default transition mode"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Crossfade seconds" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><Slider Minimum="0" Maximum="10" SmallChange="0.25" LargeChange="1" TickFrequency="0.25" Value="{Binding SettingsWorkspace.CrossfadeSeconds}" Margin="0,5,0,0" AutomationProperties.Name="Crossfade duration" AutomationProperties.ItemStatus="{Binding SettingsWorkspace.CrossfadeSeconds, StringFormat={}{0:0.##} seconds}" AutomationProperties.HelpText="Use Arrow keys for quarter-second steps and Page Up or Page Down for one-second steps."/></StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Fade in seconds" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><Slider Minimum="0" Maximum="10" SmallChange="0.25" LargeChange="1" TickFrequency="0.25" Value="{Binding SettingsWorkspace.FadeInSeconds}" AutomationProperties.Name="Fade in duration" AutomationProperties.ItemStatus="{Binding SettingsWorkspace.FadeInSeconds, StringFormat={}{0:0.##} seconds}"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Fade out seconds" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><Slider Minimum="0" Maximum="10" SmallChange="0.25" LargeChange="1" TickFrequency="0.25" Value="{Binding SettingsWorkspace.FadeOutSeconds}" AutomationProperties.Name="Fade out duration" AutomationProperties.ItemStatus="{Binding SettingsWorkspace.FadeOutSeconds, StringFormat={}{0:0.##} seconds}"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Bit-perfect mode" FontWeight="SemiBold"/>
                            <TextBlock Text="Exclusive WASAPI with no DSP bypasses the shared Windows mixer. ReplayGain, crossfade, speed, pitch, fades, and software volume deliberately use the DSP path." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="ReplayGain processing" FontWeight="SemiBold"/>
                            <TextBlock Text="Choose track or album normalization. The preamp is applied after the stored gain value." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,5,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Mode" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                    <ComboBox ItemsSource="{Binding SettingsWorkspace.ReplayGainModes}" SelectedItem="{Binding SettingsWorkspace.ReplayGainMode}" Margin="0,5,0,0" AutomationProperties.Name="ReplayGain mode"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Preamp" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SettingsWorkspace.ReplayGainPreampDb, StringFormat={}{0:+0.0;-0.0;0.0} dB}" Foreground="{DynamicResource AccentBrush}" FontSize="10"/>
                                    </Grid>
                                    <Slider Minimum="-20" Maximum="20" SmallChange="0.5" LargeChange="2" TickFrequency="0.5" Value="{Binding SettingsWorkspace.ReplayGainPreampDb}" Margin="0,5,0,0" AutomationProperties.Name="ReplayGain preamp" AutomationProperties.ItemStatus="{Binding SettingsWorkspace.ReplayGainPreampDb, StringFormat={}{0:+0.0;-0.0;0.0} decibels}"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="Prevent digital clipping with the sample-peak guard" IsChecked="{Binding SettingsWorkspace.PreventClipping}" Margin="0,14,0,0"/>
                            <TextBlock Text="This is a sample-peak safety guard, not an oversampled true-peak limiter. DoP playback bypasses all ReplayGain processing." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Margin="24,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Tempo and pitch" FontWeight="SemiBold"/>
                            <TextBlock Text="High-quality SoundTouch processing replaces the old linear/FFT path. Changes rebuild the stream at the current media position." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,5,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Speed" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SettingsWorkspace.PlaybackSpeed, StringFormat={}{0:0.00}×}" Foreground="{DynamicResource AccentBrush}" FontSize="10"/>
                                    </Grid>
                                    <Slider Minimum="0.5" Maximum="1.5" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" Value="{Binding SettingsWorkspace.PlaybackSpeed}" Margin="0,5,0,0" AutomationProperties.Name="Playback speed" AutomationProperties.ItemStatus="{Binding SettingsWorkspace.PlaybackSpeed, StringFormat={}{0:0.00} times}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Pitch" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SettingsWorkspace.PitchSemitones, StringFormat={}{0:+0.0;-0.0;0.0} st}" Foreground="{DynamicResource AccentBrush}" FontSize="10"/>
                                    </Grid>
                                    <Slider Minimum="-12" Maximum="12" SmallChange="1" LargeChange="3" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SettingsWorkspace.PitchSemitones}" Margin="0,5,0,0" AutomationProperties.Name="Pitch shift" AutomationProperties.ItemStatus="{Binding SettingsWorkspace.PitchSemitones, StringFormat={}{0:+0.0;-0.0;0.0} semitones}"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="Preserve pitch when changing speed" IsChecked="{Binding SettingsWorkspace.PreservePitch}" Margin="0,14,0,0"/>
                            <TextBlock Text="SoundTouch is used only when speed or pitch differs from normal. Mono and stereo are supported; DoP remains unprocessed." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Margin="24,4,0,0"/>
                            <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Seek step (seconds)" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><Slider Minimum="1" Maximum="60" SmallChange="1" LargeChange="5" TickFrequency="1" Value="{Binding SettingsWorkspace.SeekStepSeconds}" AutomationProperties.Name="Configured seek step" AutomationProperties.ItemStatus="{Binding SettingsWorkspace.SeekStepSeconds, StringFormat={}{0:0} seconds}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Volume step (percent)" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><Slider Minimum="1" Maximum="25" SmallChange="1" LargeChange="5" TickFrequency="1" Value="{Binding SettingsWorkspace.VolumeStepPercent}" AutomationProperties.Name="Configured volume step" AutomationProperties.ItemStatus="{Binding SettingsWorkspace.VolumeStepPercent, StringFormat={}{0:0} percent}"/></StackPanel></Grid>
                            <TextBlock Text="{Binding SettingsWorkspace.PlaybackStatus}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,12,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Style="{StaticResource PrimaryButton}" Content="Apply playback" Click="ApplyPlayback_Click" Margin="0,0,8,0"/><Button Content="Revert" Click="RevertPlayback_Click"/></StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Analyze missing loudness data" FontWeight="SemiBold"/>
                            <TextBlock Text="Measures mono/stereo tracks with EBU R128 gating and stores ReplayGain 2.0 track gain, album gain, and sample peak in the local database. Music files are read-only. Analysis automatically waits while playback is active." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,5,0,12"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ReplayGainAnalysisProgress, Mode=OneWay}" Height="4"/>
                            <TextBlock Text="{Binding ReplayGainAnalysisStatus}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="Analyze missing" Click="AnalyzeReplayGain_Click" Margin="0,0,8,0"/>
                                <Button Content="Cancel" Click="CancelReplayGain_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="_Library" AutomationProperties.Name="Library settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True">
                <StackPanel Margin="34,28">
                    <TextBlock Text="Library" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Local, mounted, and SMB music sources" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,22"/>
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Music sources" FontWeight="SemiBold"/>
                            <TextBlock Text="Enable, watch, or rescan each source independently. Removing a source only removes its entries from this app; music files are never changed." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,14"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="Add source" Click="AddLibrarySource_Click" Margin="0,0,8,0"/>
                                <Button Command="{Binding ScanCommand}" Content="Rescan enabled"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding LibrarySources}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,0,0">
                                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#FFFFB454"/><Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Fill" Value="#FF69D39B"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                            <TextBlock Text="{Binding Root}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Error}" Foreground="#FFFF8F8F" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding LastSuccessfulScan, StringFormat={}{0:g}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LastSuccessfulScan}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding TrackCount, StringFormat={}{0:N0} tracks}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,4,0,8" HorizontalAlignment="Right"/>
                                            <StackPanel Orientation="Horizontal" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Button Content="{Binding EnabledActionText}" Command="{Binding Tag.ToggleLibrarySourceCommand, RelativeSource={RelativeSource AncestorType=StackPanel}}" CommandParameter="{Binding}" Margin="0,0,5,0" Padding="9,4"/>
                                                <Button Content="{Binding WatcherActionText}" Command="{Binding Tag.ToggleSourceWatcherCommand, RelativeSource={RelativeSource AncestorType=StackPanel}}" CommandParameter="{Binding}" Margin="0,0,5,0" Padding="9,4"/>
                                                <Button Content="Rescan" Command="{Binding Tag.RescanSourceCommand, RelativeSource={RelativeSource AncestorType=StackPanel}}" CommandParameter="{Binding}" Margin="0,0,5,0" Padding="9,4"/>
                                                <Button Content="Remove" Click="RemoveLibrarySource_Click" Tag="{Binding}" Padding="9,4"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Excluded folders" FontWeight="SemiBold"/><TextBlock Text="Excluded paths and everything beneath them are skipped during scans." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Add exclusion" Click="AddExclusion_Click"/></Grid>
                            <ItemsControl ItemsSource="{Binding LibraryExclusions}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Remove" Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="9,4"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Scan activity" FontWeight="SemiBold"/><TextBlock Text="{Binding ScanCurrentSource, StringFormat={}Source: {0}}" Foreground="{DynamicResource AccentBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/><TextBlock Text="{Binding ScanCurrentPath}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="{Binding ScanPauseText}" Command="{Binding ToggleScanPauseCommand}" Margin="0,0,6,0"/><Button Content="Cancel" Command="{Binding CancelScanCommand}"/></StackPanel></Grid>
                            <ProgressBar Minimum="0" Maximum="{Binding ScanProgressMaximum, Mode=OneWay}" Value="{Binding ScanProgressValue, Mode=OneWay}" Height="5" Margin="0,14,0,8"/>
                            <UniformGrid Columns="5"><TextBlock Text="{Binding ScanDiscovered, StringFormat={}Found {0:N0}}"/><TextBlock Text="{Binding ScanProcessed, StringFormat={}Read {0:N0}}"/><TextBlock Text="{Binding ScanAdded, StringFormat={}Added {0:N0}}"/><TextBlock Text="{Binding ScanUpdated, StringFormat={}Updated {0:N0}}"/><TextBlock Text="{Binding ScanFailed, StringFormat={}Failed {0:N0}}"/></UniformGrid>
                            <Expander Header="Failure details" IsExpanded="False" Visibility="{Binding HasScanFailures, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0"><ItemsControl ItemsSource="{Binding ScanFailures}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5"><TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Message}" Foreground="#FFFF8F8F" FontSize="10" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Background scanning" FontWeight="SemiBold"/>
                            <TextBlock Text="Checks for library changes on a conservative schedule. By default it waits for AC power and an unmetered connection." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,5,0,12"/>
                            <CheckBox Content="Enable scheduled scans" IsChecked="{Binding ScheduledScanEnabled}"/>
                            <Grid Margin="24,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Interval in minutes (15–1440)" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding ScheduledScanIntervalMinutes, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Scheduled scan interval in minutes" AutomationProperties.HelpText="Enter a whole number from 15 through 1440."/></Grid>
                            <CheckBox Content="Allow scheduled scans on battery" IsChecked="{Binding AllowScheduledScanOnBattery}" Margin="24,10,0,0"/>
                            <CheckBox Content="Allow scheduled scans on metered networks" IsChecked="{Binding AllowScheduledScanOnMeteredNetwork}" Margin="24,8,0,0"/>
                            <TextBlock Text="{Binding ScheduledScanStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Artwork cache" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ArtworkCacheStatus}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,5,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Slider Minimum="64" Maximum="4096" SmallChange="64" LargeChange="256" TickFrequency="64" IsSnapToTickEnabled="True" Value="{Binding ArtworkCacheMegabytes}" AutomationProperties.Name="Artwork cache limit" AutomationProperties.ItemStatus="{Binding ArtworkCacheLimitText}" AutomationProperties.HelpText="Use Arrow keys for 64 megabyte steps and Page Up or Page Down for 256 megabyte steps."/>
                                <TextBlock Grid.Column="1" Text="{Binding ArtworkCacheLimitText}" Foreground="{DynamicResource TextMutedBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Clearing removes originals and thumbnails. Rebuild reads embedded covers from every available library file." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,9,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding RebuildArtworkCacheCommand}" Content="Rebuild cache" Margin="0,0,8,0"/>
                                <Button Command="{Binding ClearArtworkCacheCommand}" Content="Clear cache" Margin="0,0,8,0"/>
                                <Button Command="{Binding RefreshArtworkCacheCommand}" Content="Refresh size"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Duplicate analysis" FontWeight="SemiBold"/>
                            <TextBlock Text="A read-only, cancellable SHA-256 comparison runs only for same-size available files. Nothing is removed automatically." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,5,0,10"/>
                            <TextBlock Text="{Binding DuplicateScanStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,0,0,12"/>
                            <Button Content="Find content duplicates" Click="FindDuplicates_Click" HorizontalAlignment="Left"/>
                            <ItemsControl ItemsSource="{Binding DuplicateGroups}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0FFFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Tracks.Count, StringFormat={}{0} identical files}" FontWeight="SemiBold"/>
                                                <ItemsControl ItemsSource="{Binding Tracks}" Margin="0,5,0,0">
                                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Path}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis"/></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="_Metadata" AutomationProperties.Name="Metadata settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True">
                <StackPanel Margin="34,28">
                    <TextBlock Text="Metadata" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Tag parsing, edit safety, and opt-in online matching" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,22"/>
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Tag behavior" FontWeight="SemiBold"/>
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Multi-value separators" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><TextBox Text="{Binding SettingsWorkspace.MultiValueSeparators, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" ToolTip="Characters used to split artist and genre values" AutomationProperties.Name="Multi-value separators" AutomationProperties.HelpText="Characters used to split artist and genre values."/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Default edit destination" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding SettingsWorkspace.MetadataWriteModes}" SelectedItem="{Binding SettingsWorkspace.DefaultMetadataWriteMode}" Margin="0,5,0,0" AutomationProperties.Name="Default metadata edit destination"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Database-only is safest. Writing tags to files is always confirmed in the editor." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Online lookup" FontWeight="SemiBold"/>
                            <CheckBox Content="Enable online metadata lookup" IsChecked="{Binding SettingsWorkspace.MetadataLookupEnabled}" Margin="0,12,0,0"/>
                            <CheckBox Content="MusicBrainz and Cover Art Archive" IsChecked="{Binding SettingsWorkspace.MusicBrainzLookupEnabled}" Margin="0,10,0,0"/>
                            <CheckBox Content="Discogs" IsChecked="{Binding SettingsWorkspace.DiscogsLookupEnabled}" Margin="0,10,0,0"/>
                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Discogs user token (optional)" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><TextBox Text="{Binding SettingsWorkspace.DiscogsUserToken, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" AutomationProperties.Name="Discogs user token"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Cache lifetime (days)" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><TextBox Text="{Binding SettingsWorkspace.MetadataCacheDays, UpdateSourceTrigger=LostFocus}" Margin="0,5,0,0" AutomationProperties.Name="Metadata cache lifetime in days"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Provider requests are serialized, cached locally, and shown for review before any edit." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding SettingsWorkspace.MetadataStatus}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="2,12,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Style="{StaticResource PrimaryButton}" Content="Apply metadata" Click="ApplyMetadataPreferences_Click" Margin="0,0,8,0"/><Button Content="Revert" Click="RevertMetadataPreferences_Click"/></StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="L_yrics" AutomationProperties.Name="Lyrics settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto" ui:SmoothScrollBehavior.Enabled="True">
                <StackPanel Margin="34,28">
                    <TextBlock Text="Lyrics" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock Text="Timing, typography, and local lyric behavior" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,22"/>
                    <Border Style="{StaticResource Card}" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Display" FontWeight="SemiBold"/>
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Mode" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding LyricsDisplayModes}" SelectedItem="{Binding LyricsDisplayMode}" Margin="0,5,0,0" AutomationProperties.Name="Lyrics display mode"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Alignment" Foreground="{DynamicResource TextMutedBrush}" FontSize="10"/><ComboBox ItemsSource="{Binding LyricsAlignments}" SelectedItem="{Binding LyricsAlignment}" Margin="0,5,0,0" AutomationProperties.Name="Lyrics alignment"/></StackPanel></Grid>
                            <TextBlock Text="Font size" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,14,0,0"/><Slider Minimum="14" Maximum="52" SmallChange="1" LargeChange="4" TickFrequency="1" Value="{Binding LyricsFontSize}" Margin="0,5,0,0" AutomationProperties.Name="Lyrics font size" AutomationProperties.ItemStatus="{Binding LyricsFontSize, StringFormat={}{0:0} points}"/>
                            <TextBlock Text="Line spacing" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,14,0,0"/><Slider Minimum="0.8" Maximum="2" SmallChange="0.05" LargeChange="0.2" TickFrequency="0.05" Value="{Binding LyricsLineSpacing}" Margin="0,5,0,0" AutomationProperties.Name="Lyrics line spacing" AutomationProperties.ItemStatus="{Binding LyricsLineSpacing, StringFormat={}{0:0.00} times}"/>
                            <TextBlock Text="Artwork blur" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,14,0,0"/><Slider Minimum="0" Maximum="20" SmallChange="1" LargeChange="5" TickFrequency="1" Value="{Binding LyricsBlurStrength}" Margin="0,5,0,0" AutomationProperties.Name="Lyrics artwork blur" AutomationProperties.ItemStatus="{Binding LyricsBlurStrength, StringFormat={}{0:0}}"/>
                            <CheckBox Content="Animate karaoke words" IsChecked="{Binding KaraokeWordAnimation}" Margin="0,14,0,0"/>
                            <TextBlock Text="Word animation follows the playback timeline and automatically snaps instead when interface animations are disabled." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="24,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0"><StackPanel><TextBlock Text="Local lyric files" FontWeight="SemiBold"/><TextBlock Text="The Now Playing panel discovers exact-name LRC/TXT files first, then language variants, title matches, and embedded metadata. Alternate choices and per-track timing offsets are remembered." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,12,0,0"><StackPanel><TextBlock Text="Online lookup" FontWeight="SemiBold"/><CheckBox Content="Enable manual LRCLIB searches" IsChecked="{Binding OnlineLyricsEnabled}" Margin="0,12,0,0"/><TextBlock Text="Off by default. When you press the globe in Now Playing, the track title, artist, album, and duration are sent to LRCLIB. Results are cached locally for 30 days and are never applied until you select and confirm one. LRCLIB is credited beside the selected source." Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="24,5,0,0"/></StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Appea_rance" AutomationProperties.Name="Appearance settings">
