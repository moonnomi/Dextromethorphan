temStatus="{Binding RepeatText}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding IsRepeatEnabled}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid Width="40" Height="40"><TextBlock Text="&#xE8EE;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Width="13" Height="13" CornerRadius="7" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Visibility="{Binding IsRepeatOne, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="1" Foreground="{DynamicResource AccentForegroundBrush}" FontFamily="Segoe UI" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Width="4" Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" Visibility="{Binding IsRepeatEnabled, Converter={StaticResource BoolToVisibility}}"/></Grid></Button></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PositionText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/><Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="{Binding DurationSeconds}" SmallChange="1" LargeChange="10" Value="{Binding PositionSeconds, Mode=OneWay}" ui:SliderAccessibilityBehavior.Enabled="True" ui:SliderAccessibilityBehavior.CommitPlaybackSeek="True" AutomationProperties.Name="Playback position" AutomationProperties.ItemStatus="{Binding PositionText}" AutomationProperties.HelpText="Use Arrow keys for one-second steps, Control plus Arrow or Page Up and Page Down for ten-second steps, and Home or End for track boundaries." PreviewMouseLeftButtonDown="SeekSlider_MouseLeftButtonDown" PreviewMouseMove="SeekSlider_MouseMove" PreviewMouseLeftButtonUp="SeekSlider_MouseLeftButtonUp"/><TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Grid>
