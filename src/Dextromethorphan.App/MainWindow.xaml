<Window x:Class="Dextromethorphan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Dextromethorphan.App.UI"
        xmlns:controls="clr-namespace:Dextromethorphan.App.UI.Controls"
        xmlns:views="clr-namespace:Dextromethorphan.App.UI.Views"
        xmlns:vm="clr-namespace:Dextromethorphan.App.ViewModels"
        mc:Ignorable="d" Title="Dextromethorphan" Icon="Assets/Brand/dextromethorphan.ico" Width="1360" Height="800" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" PreviewKeyDown="Window_PreviewKeyDown" KeyDown="Window_KeyDown" PreviewMouseDown="Window_PreviewMouseDown" Closing="Window_Closing" AllowDrop="True" PreviewDragEnter="Window_PreviewDragEnter" PreviewDragOver="Window_PreviewDragOver" PreviewDragLeave="Window_PreviewDragLeave" PreviewDrop="Window_PreviewDrop"
        KeyboardNavigation.TabNavigation="Continue"
        KeyboardNavigation.ControlTabNavigation="Continue"
        AutomationProperties.Name="Dextromethorphan music player">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:FolderTreeNodeViewModel}" ItemsSource="{Binding Children}">
            <Border x:Name="FolderNodeSurface" Padding="8,7" Margin="2,1" CornerRadius="7" Background="Transparent">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding TrackCount}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,2,0"/></Grid>
            </Border>
            <HierarchicalDataTemplate.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="FolderNodeSurface" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger></HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
        <DataTemplate x:Key="TrackListTemplate">
            <views:TrackListView
                TrackListReady="TrackList_Loaded"
                TrackScrollChanged="TrackList_ScrollChanged"/>
        </DataTemplate>

        <DataTemplate x:Key="GroupCardTemplate">
            <Grid Width="{Binding DataContext.AlbumTileSize, RelativeSource={RelativeSource AncestorType=Window}}"
                  Margin="0,0,14,18"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_Open collection"
                                  Command="{Binding PlacementTarget.Tag.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="_Play collection"
                                  Command="{Binding PlacementTarget.Tag.PlayGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Play _next"
                                  Command="{Binding PlacementTarget.Tag.PlayGroupNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Add to _queue"
                                  Command="{Binding PlacementTarget.Tag.AddGroupToQueueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <Button Style="{StaticResource CardButton}"
                        Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Title, StringFormat=Open {0}}"
                        PreviewMouseLeftButtonDown="GroupCard_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="GroupCard_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="GroupCard_PreviewMouseLeftButtonUp">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="{Binding DataContext.GalleryMetadataHeight, RelativeSource={RelativeSource AncestorType=Window}}"/></Grid.RowDefinitions>
                        <Border Width="{Binding DataContext.AlbumTileSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.AlbumTileSize, RelativeSource={RelativeSource AncestorType=Window}}" CornerRadius="10,10,0,0" ClipToBounds="True" Background="{DynamicResource SurfaceRaisedBrush}">
                            <Grid><TextBlock Text="{Binding Initial}" FontSize="42" FontWeight="Light" Foreground="#45FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image ui:AsyncArtwork.Path="{Binding ArtworkPath}" ui:AsyncArtwork.DecodePixelWidth="192" ui:AsyncArtwork.Priority="Visible" ui:AsyncArtwork.ArtworkLoaded="GalleryArtwork_Loaded" Stretch="UniformToFill"/></Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="12,9">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsGridDensity, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CountText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsCompactDensity, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding DataContext.IsGridDensity, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Button>
                <Button Style="{StaticResource IconButton}" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Background="#D90B0C10" Command="{Binding DataContext.PlayGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="&#xE768;" ToolTip="Play collection" AutomationProperties.Name="{Binding Title, StringFormat=Play {0}}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GalleryRowTemplate">
            <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource GroupCardTemplate}" HorizontalAlignment="Left" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="SidebarCardTemplate">
            <Button Style="{StaticResource SidebarCardButton}" Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title, StringFormat=Open {0}}" AllowDrop="True" Drop="SidebarCard_Drop">
                <Button.ContextMenu><ContextMenu><MenuItem Header="Edit playlist" Command="{Binding PlacementTarget.DataContext.EditPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><MenuItem Header="Duplicate playlist" Command="{Binding PlacementTarget.DataContext.DuplicatePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><MenuItem Header="Add selected tracks" Command="{Binding PlacementTarget.DataContext.AddSelectedToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><Separator/><MenuItem Header="Delete playlist" Command="{Binding PlacementTarget.DataContext.DeletePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/></ContextMenu></Button.ContextMenu>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="7" ClipToBounds="True" Background="{DynamicResource SurfaceRaisedBrush}"><Grid><TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/><Image ui:AsyncArtwork.Path="{Binding ArtworkPath}" ui:AsyncArtwork.DecodePixelWidth="64" ui:AsyncArtwork.Priority="Visible" Stretch="UniformToFill"/></Grid></Border>
                    <StackPanel Grid.Column="1" Margin="9,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" Command="{Binding DataContext.PlayGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="&#xE768;" ToolTip="Play" AutomationProperties.Name="{Binding Title, StringFormat=Play {0}}"/>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid x:Name="ShellRoot" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
            <Grid.RowDefinitions><RowDefinition x:Name="TitleBarRow" Height="63"/><RowDefinition Height="*"/><RowDefinition Height="96"/></Grid.RowDefinitions>

            <!-- Custom title bar and primary library tabs -->
            <Border x:Name="TitleBarHost" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
                    <Button Margin="8" Padding="0" Command="{Binding NavigateCommand}" CommandParameter="Now Playing" ToolTip="Now playing" AutomationProperties.Name="Dextromethorphan — Now playing">
                        <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="#28FFFFFF" BorderThickness="1"><Image Source="Assets/Brand/dextromethorphan-symbol-compact.png" Margin="5" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                    </Button>
                    <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <UniformGrid Rows="1">
                            <RadioButton Style="{StaticResource TopTab}" Content="AL_BUMS" AutomationProperties.Name="Albums" AutomationProperties.HelpText="Open the album library. Access key Alt+B." Command="{Binding NavigateCommand}" CommandParameter="Albums" IsChecked="{Binding CurrentView, Converter={StaticResource StringEquals}, ConverterParameter=Albums, Mode=OneWay}" Checked="TopTab_Checked" Unchecked="TopTab_Unchecked"/>
                            <RadioButton Style="{StaticResource TopTab}" Content="A_RTISTS" AutomationProperties.Name="Artists" AutomationProperties.HelpText="Open the artist library. Access key Alt+R." Command="{Binding NavigateCommand}" CommandParameter="Artists" IsChecked="{Binding CurrentView, Converter={StaticResource StringEquals}, ConverterParameter=Artists, Mode=OneWay}" Checked="TopTab_Checked" Unchecked="TopTab_Unchecked"/>
                            <RadioButton Style="{StaticResource TopTab}" Content="_GENRES" AutomationProperties.Name="Genres" AutomationProperties.HelpText="Open the genre library. Access key Alt+G." Command="{Binding NavigateCommand}" CommandParameter="Genres" IsChecked="{Binding CurrentView, Converter={StaticResource StringEquals}, ConverterParameter=Genres, Mode=OneWay}" Checked="TopTab_Checked" Unchecked="TopTab_Unchecked"/>
                            <RadioButton Style="{StaticResource TopTab}" Content="_SONGS" AutomationProperties.Name="Songs" AutomationProperties.HelpText="Open all songs. Access key Alt+S." Command="{Binding NavigateCommand}" CommandParameter="Songs" IsChecked="{Binding CurrentView, Converter={StaticResource StringEquals}, ConverterParameter=Songs, Mode=OneWay}" Checked="TopTab_Checked" Unchecked="TopTab_Unchecked"/>
                            <RadioButton Style="{StaticResource TopTab}" Content="_FOLDERS" AutomationProperties.Name="Folders" AutomationProperties.HelpText="Browse music folders. Access key Alt+F." Command="{Binding NavigateCommand}" CommandParameter="Folders" IsChecked="{Binding CurrentView, Converter={StaticResource StringEquals}, ConverterParameter=Folders, Mode=OneWay}" Checked="TopTab_Checked" Unchecked="TopTab_Unchecked"/>
                            <RadioButton Style="{StaticResource TopTab}" Content="_PLAYLISTS" AutomationProperties.Name="Playlists" AutomationProperties.HelpText="Open playlists. Access key Alt+P." Command="{Binding NavigateCommand}" CommandParameter="Playlists" IsChecked="{Binding CurrentView, Converter={StaticResource StringEquals}, ConverterParameter=Playlists, Mode=OneWay}" Checked="TopTab_Checked" Unchecked="TopTab_Unchecked"/>
                        </UniformGrid>
                        <Border Grid.Column="1" Width="176" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,3" Visibility="{Binding IsCollectionDetailOpen, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="12,0,5,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DetailTabTitle}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12" Content="&#xE8BB;" Command="{Binding CloseCollectionCommand}" ToolTip="Close collection" AutomationProperties.Name="Close collection tab"/></Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Column="2" Margin="8,11">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE721;" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" Panel.ZIndex="1" IsHitTestVisible="False"/>
                        <TextBlock Text="Search library" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="38,0,10,0" Panel.ZIndex="1" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="38,0,10,0" VerticalContentAlignment="Center" ToolTip="Search title, artist, album, genre, filename, or comment. Advanced fields include artist:, year:, rating:, and codec:." AutomationProperties.Name="Search library" AutomationProperties.AutomationId="SearchBox" ContextMenuOpening="SearchBox_ContextMenuOpening"><TextBox.ContextMenu><ContextMenu/></TextBox.ContextMenu></TextBox>
                    </Grid>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Click="OpenContextMenu_Click" Content="&#xE712;" ToolTip="More library views" AutomationProperties.Name="More library views">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Recently added" Command="{Binding NavigateCommand}" CommandParameter="Recently Added"/>
                                    <MenuItem Header="Recently played" Command="{Binding NavigateCommand}" CommandParameter="Recently Played"/>
                                    <MenuItem Header="Most played" Command="{Binding NavigateCommand}" CommandParameter="Most Played"/>
                                    <MenuItem Header="Never played" Command="{Binding NavigateCommand}" CommandParameter="Never Played"/>
                                    <MenuItem Header="History" Command="{Binding NavigateCommand}" CommandParameter="History"/>
                                    <MenuItem Header="Now playing" Command="{Binding NavigateCommand}" CommandParameter="Now Playing"/>
                                    <Separator/>
                                    <MenuItem Header="Now Playing modules">
                                        <MenuItem Header="Album artwork" IsCheckable="True" IsChecked="{Binding DataContext.DashboardModules, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource CollectionContainsBool}, ConverterParameter=Artwork, Mode=OneWay}" Command="{Binding DataContext.ToggleDashboardModuleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="Artwork"/>
                                        <MenuItem Header="Ambience mode" IsCheckable="True" IsChecked="{Binding DataContext.AmbienceEnabled, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="Lyrics" IsCheckable="True" IsChecked="{Binding DataContext.DashboardModules, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource CollectionContainsBool}, ConverterParameter=Lyrics, Mode=OneWay}" Command="{Binding DataContext.ToggleDashboardModuleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="Lyrics"/>
                                        <MenuItem Header="Track details" IsCheckable="True" IsChecked="{Binding DataContext.DashboardModules, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource CollectionContainsBool}, ConverterParameter=Metadata, Mode=OneWay}" Command="{Binding DataContext.ToggleDashboardModuleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="Metadata"/>
                                    </MenuItem>
                                    <MenuItem Header="Show queue panel" IsCheckable="True" IsChecked="{Binding DataContext.QueueVisible, RelativeSource={RelativeSource AncestorType=ContextMenu}, Mode=OneWay}" Command="{Binding DataContext.ToggleQueueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding NavigateCommand}" CommandParameter="Favorites" Content="&#xEB52;" ToolTip="Favorites" AutomationProperties.Name="Favorites"/>
                        <Button Style="{StaticResource IconButton}" Command="{Binding NavigateCommand}" CommandParameter="Missing" Content="&#xE7BA;" ToolTip="Missing files" AutomationProperties.Name="Missing files" Visibility="{Binding HasMissingTracks, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleQueueCommand}" Content="&#xE8FD;" ToolTip="Toggle queue" AutomationProperties.Name="Toggle queue"/>
                        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="Settings_Click" Content="&#xE713;" ToolTip="Settings" AutomationProperties.Name="Settings" AutomationProperties.AutomationId="SettingsButton"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize window"/>
                        <Button Style="{StaticResource WindowButton}" Click="Maximize_Click" Content="&#xE922;" ToolTip="Maximize" AutomationProperties.Name="Maximize or restore window"/>
                        <Button Style="{StaticResource CloseWindowButton}" Click="Close_Click" Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close window"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content and queue -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid x:Name="ViewTransitionHost" Grid.Column="1" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Height="88" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="26,0">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsCollectionDetailOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0" ToolTip="{Binding StatusText}"><TextBlock Text="{Binding ViewTitle}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding ViewSubtitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" ClipToBounds="True">
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsNowPlayingView, Converter={StaticResource InverseBoolToVisibility}}">
                                <ComboBox Width="116" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" Margin="0,0,5,0" ToolTip="Choose how to sort this view" AutomationProperties.Name="Sort by" AutomationProperties.AutomationId="SortFieldComboBox"/>
                                <Button Style="{StaticResource IconButton}" Command="{Binding ToggleSortDirectionCommand}" Width="36" Height="36" Margin="0,0,4,0" Content="{Binding SortDirectionGlyph}" ToolTip="{Binding SortDirectionToolTip}" AutomationProperties.Name="{Binding SortDirectionLabel}" AutomationProperties.AutomationId="SortDirectionButton">
                                </Button>
                                <Button Click="OpenContextMenu_Click" Width="36" Height="36" Margin="0,0,4,0" Content="&#xE71C;" ToolTip="{Binding QuickFilterToolTip}" AutomationProperties.Name="{Binding QuickFilterLabel}" AutomationProperties.AutomationId="LibraryFilterButton">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                            <Style.Triggers><DataTrigger Binding="{Binding HasQuickFilter}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Clear filter" Command="{Binding DataContext.ClearQuickFilterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="Lossless" IsCheckable="True" IsChecked="{Binding DataContext.QuickFilter, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource StringEquals}, ConverterParameter=lossless, Mode=OneWay}" Command="{Binding DataContext.SetQuickFilterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="lossless"/>
                                            <MenuItem Header="Loved" IsCheckable="True" IsChecked="{Binding DataContext.QuickFilter, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource StringEquals}, ConverterParameter=loved, Mode=OneWay}" Command="{Binding DataContext.SetQuickFilterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="loved"/>
                                            <MenuItem Header="Unloved" IsCheckable="True" IsChecked="{Binding DataContext.QuickFilter, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource StringEquals}, ConverterParameter=unloved, Mode=OneWay}" Command="{Binding DataContext.SetQuickFilterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="unloved"/>
                                            <MenuItem Header="Compilations" IsCheckable="True" IsChecked="{Binding DataContext.QuickFilter, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource StringEquals}, ConverterParameter=compilation, Mode=OneWay}" Command="{Binding DataContext.SetQuickFilterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="compilation"/>
                                            <MenuItem Header="Rating 4+" IsCheckable="True" IsChecked="{Binding DataContext.QuickFilter, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource StringEquals}, ConverterParameter='rating:&gt;=4', Mode=OneWay}" Command="{Binding DataContext.SetQuickFilterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="rating:&gt;=4"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                </StackPanel>
                                <Button Style="{StaticResource IconButton}" Command="{Binding ScanCommand}" Content="&#xE72C;" ToolTip="Rescan library" AutomationProperties.Name="Rescan library"/>
                                <Button Style="{StaticResource IconButton}" Command="{Binding ToggleScanPauseCommand}" Content="{Binding ScanPauseGlyph}" ToolTip="{Binding ScanPauseText}" AutomationProperties.Name="{Binding ScanPauseText}" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Style="{StaticResource IconButton}" Command="{Binding CancelScanCommand}" Content="&#xE71A;" ToolTip="Cancel library scan" AutomationProperties.Name="Cancel library scan" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Style="{StaticResource IconButton}" Click="OpenContextMenu_Click" Content="&#xE712;" ToolTip="More actions" AutomationProperties.Name="More actions">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="New playlist" Command="{Binding NewPlaylistCommand}"/>
                                            <MenuItem Header="Import playlist" Click="ImportPlaylistMenuItem_Click"/>
                                            <MenuItem Header="Export selected playlist" Click="ExportPlaylistMenuItem_Click" Visibility="{Binding IsPlaylistView, Converter={StaticResource BoolToVisibility}}"/>
                                            <MenuItem Header="Save queue as playlist" Command="{Binding SaveQueueAsPlaylistCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Undo playlist change" Command="{Binding UndoPlaylistCommand}"/>
                                            <MenuItem Header="Redo playlist change" Command="{Binding RedoPlaylistCommand}"/>
                                            <Separator/>
                                            <MenuItem Header="Add music folder" Click="AddFolder_Click"/>
                                            <MenuItem Header="Developer performance overlay" Click="PerformanceOverlayMenuItem_Click" InputGestureText="Ctrl+Shift+F12"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <!-- Albums, artists and genres are cover-first gallery pages. -->
                        <Grid Visibility="{Binding IsGroupView, Converter={StaticResource BoolToVisibility}}" Margin="24,18,24,16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Browse collections" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource IconButton}" Click="OpenContextMenu_Click" Content="&#xE71D;" ToolTip="View options" AutomationProperties.Name="View options"><Button.ContextMenu><ContextMenu>
                                <MenuItem Header="Display mode">
                                    <MenuItem Header="Comfortable" IsCheckable="True" IsChecked="{Binding DataContext.Density, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource StringEquals}, ConverterParameter=Comfortable, Mode=OneWay}" Command="{Binding DataContext.SetDensityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="Comfortable"/>
                                    <MenuItem Header="Compact" IsCheckable="True" IsChecked="{Binding DataContext.Density, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource StringEquals}, ConverterParameter=Compact, Mode=OneWay}" Command="{Binding DataContext.SetDensityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="Compact"/>
                                    <MenuItem Header="Grid" IsCheckable="True" IsChecked="{Binding DataContext.Density, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource StringEquals}, ConverterParameter=Grid, Mode=OneWay}" Command="{Binding DataContext.SetDensityCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="Grid"/>
                                </MenuItem>
                                <MenuItem Header="Cover size">
                                    <MenuItem Header="Small" IsCheckable="True" IsChecked="{Binding DataContext.AlbumTileSize, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource StringEquals}, ConverterParameter=120, Mode=OneWay}" Command="{Binding DataContext.SetAlbumTileSizeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="120"/>
