<Window x:Class="Dextromethorphan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Dextromethorphan.App.UI"
        mc:Ignorable="d" Title="Dextromethorphan" Icon="Assets/Brand/dextromethorphan.ico" Width="1360" Height="800" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" KeyDown="Window_KeyDown" PreviewMouseDown="Window_PreviewMouseDown" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="10" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="TrackListTemplate">
            <ListBox Style="{StaticResource TrackListStyle}" ItemsSource="{Binding BrowseTracks}" SelectedItem="{Binding SelectedTrack}" MouseDoubleClick="TrackList_MouseDoubleClick" Loaded="TrackList_Loaded" ScrollViewer.ScrollChanged="TrackList_ScrollChanged">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Play" Command="{Binding PlacementTarget.DataContext.PlaySelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Play next" Command="{Binding PlacementTarget.DataContext.PlayNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Add to queue" Command="{Binding PlacementTarget.DataContext.AddToQueueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="58" Margin="6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="1.8*" MinWidth="120"/>
                                <ColumnDefinition Width="1.05*" MinWidth="90"/>
                                <ColumnDefinition Width="146"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="58"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TrackNumber}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Artist}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,14,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Album}" Foreground="#D7F4F6FA" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Year}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding QualityText}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="&#x2665;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/><Setter Property="Opacity" Value="0.18"/><Style.Triggers><DataTrigger Binding="{Binding IsLoved}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="5" Text="{Binding DurationText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DataTemplate>

        <DataTemplate x:Key="GroupCardTemplate">
            <Grid Width="{Binding DataContext.AlbumTileSize, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,14,18">
                <Button Style="{StaticResource CardButton}" Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="76"/></Grid.RowDefinitions>
                        <Border Width="{Binding DataContext.AlbumTileSize, RelativeSource={RelativeSource AncestorType=Window}}" Height="{Binding DataContext.AlbumTileSize, RelativeSource={RelativeSource AncestorType=Window}}" CornerRadius="10,10,0,0" ClipToBounds="True" Background="{StaticResource SurfaceRaisedBrush}">
                            <Grid><TextBlock Text="{Binding Initial}" FontSize="42" FontWeight="Light" Foreground="#45FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image ui:AsyncArtwork.Path="{Binding ArtworkPath}" ui:AsyncArtwork.DecodePixelWidth="192" ui:AsyncArtwork.Priority="Visible" ui:AsyncArtwork.ArtworkLoaded="GalleryArtwork_Loaded" Stretch="UniformToFill"/></Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="12,10"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CountText}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                    </Grid>
                </Button>
                <Button Style="{StaticResource IconButton}" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Background="#D90B0C10" Command="{Binding DataContext.PlayGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="&#xE768;" ToolTip="Play collection"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SidebarCardTemplate">
            <Button Style="{StaticResource SidebarCardButton}" Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="7" ClipToBounds="True" Background="{StaticResource SurfaceRaisedBrush}"><Grid><TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><Image ui:AsyncArtwork.Path="{Binding ArtworkPath}" ui:AsyncArtwork.DecodePixelWidth="64" ui:AsyncArtwork.Priority="Visible" Stretch="UniformToFill"/></Grid></Border>
                    <StackPanel Grid.Column="1" Margin="9,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" Command="{Binding DataContext.PlayGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="&#xE768;" ToolTip="Play"/>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="63"/><RowDefinition Height="*"/><RowDefinition Height="96"/></Grid.RowDefinitions>

            <!-- Custom title bar and primary library tabs -->
            <Border Grid.Row="0" Background="#FA0E1015" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="88"/><ColumnDefinition Width="138"/></Grid.ColumnDefinitions>
                    <Button Margin="8" Padding="0" Command="{Binding NavigateCommand}" CommandParameter="Now Playing" ToolTip="Now playing" AutomationProperties.Name="Dextromethorphan — Now playing">
                        <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="#28FFFFFF" BorderThickness="1"><Image Source="Assets/Brand/dextromethorphan-symbol-compact.png" Margin="5" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                    </Button>
                    <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <UniformGrid Rows="1">
                            <RadioButton Style="{StaticResource TopTab}" Content="ALBUMS" Command="{Binding NavigateCommand}" CommandParameter="Albums" IsChecked="{Binding CurrentView, Converter={StaticResource StringEquals}, ConverterParameter=Albums, Mode=OneWay}" Checked="TopTab_Checked" Unchecked="TopTab_Unchecked"/>
                            <RadioButton Style="{StaticResource TopTab}" Content="ARTISTS" Command="{Binding NavigateCommand}" CommandParameter="Artists" IsChecked="{Binding CurrentView, Converter={StaticResource StringEquals}, ConverterParameter=Artists, Mode=OneWay}" Checked="TopTab_Checked" Unchecked="TopTab_Unchecked"/>
                            <RadioButton Style="{StaticResource TopTab}" Content="GENRES" Command="{Binding NavigateCommand}" CommandParameter="Genres" IsChecked="{Binding CurrentView, Converter={StaticResource StringEquals}, ConverterParameter=Genres, Mode=OneWay}" Checked="TopTab_Checked" Unchecked="TopTab_Unchecked"/>
                            <RadioButton Style="{StaticResource TopTab}" Content="SONGS" Command="{Binding NavigateCommand}" CommandParameter="Songs" IsChecked="{Binding CurrentView, Converter={StaticResource StringEquals}, ConverterParameter=Songs, Mode=OneWay}" Checked="TopTab_Checked" Unchecked="TopTab_Unchecked"/>
                            <RadioButton Style="{StaticResource TopTab}" Content="FOLDERS" Command="{Binding NavigateCommand}" CommandParameter="Folders" IsChecked="{Binding CurrentView, Converter={StaticResource StringEquals}, ConverterParameter=Folders, Mode=OneWay}" Checked="TopTab_Checked" Unchecked="TopTab_Unchecked"/>
                            <RadioButton Style="{StaticResource TopTab}" Content="PLAYLISTS" Command="{Binding NavigateCommand}" CommandParameter="Playlists" IsChecked="{Binding CurrentView, Converter={StaticResource StringEquals}, ConverterParameter=Playlists, Mode=OneWay}" Checked="TopTab_Checked" Unchecked="TopTab_Unchecked"/>
                        </UniformGrid>
                        <Border Grid.Column="1" Width="176" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,3" Visibility="{Binding IsCollectionDetailOpen, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="12,0,5,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DetailTabTitle}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="1" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="12" Content="&#xE8BB;" Command="{Binding CloseCollectionCommand}" ToolTip="Close collection"/></Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Column="2" Margin="8,11"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE721;" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" Panel.ZIndex="1"/><TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="38,0,10,0" VerticalContentAlignment="Center" ToolTip="Search title, artist, album, genre, filename, or comment"/></Grid>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Command="{Binding NavigateCommand}" CommandParameter="Favorites" Content="&#xEB52;" ToolTip="Favorites"/>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleQueueCommand}" Content="&#xE8FD;" ToolTip="Toggle queue"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" Content="&#xE921;" ToolTip="Minimize"/>
                        <Button Style="{StaticResource WindowButton}" Click="Maximize_Click" Content="&#xE922;" ToolTip="Maximize"/>
                        <Button Style="{StaticResource CloseWindowButton}" Click="Close_Click" Content="&#xE8BB;" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content and queue -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid x:Name="ViewTransitionHost" Grid.Column="0" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Height="88" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="26,0">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsCollectionDetailOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ViewTitle}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{Binding ViewSubtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Style="{StaticResource IconButton}" Command="{Binding ScanCommand}" Content="&#xE72C;" ToolTip="Rescan library" AutomationProperties.Name="Rescan library"/><Button Style="{StaticResource IconButton}" Click="AddFolder_Click" Content="&#xE8B7;" ToolTip="Add music folder" AutomationProperties.Name="Add music folder"/><Button Style="{StaticResource IconButton}" Command="{Binding ToggleDiagnosticsCommand}" Content="&#xE9D9;" ToolTip="Audio diagnostics" AutomationProperties.Name="Audio diagnostics"/><Button Style="{StaticResource IconButton}" Command="{Binding PerformanceOverlay.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}" Content="FPS" FontFamily="Segoe UI" FontSize="9" FontWeight="Bold" ToolTip="Developer performance overlay (Ctrl+Shift+F12)" AutomationProperties.Name="Developer performance overlay"/><Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="Settings_Click" Content="&#xE713;" ToolTip="Settings" AutomationProperties.Name="Settings" AutomationProperties.AutomationId="SettingsButton"/></StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <!-- Albums, artists and genres are cover-first gallery pages. -->
                        <Grid Visibility="{Binding IsGroupView, Converter={StaticResource BoolToVisibility}}" Margin="24,18,24,16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Browse collections" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Cover size" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/><Slider Width="100" Minimum="110" Maximum="210" Value="{Binding AlbumTileSize}"/></StackPanel></Grid>
                            <ListBox x:Name="GalleryList" Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource GalleryListStyle}" ItemsSource="{Binding GalleryGroups}" ItemTemplate="{StaticResource GroupCardTemplate}" Loaded="GalleryList_Loaded" ScrollViewer.ScrollChanged="Gallery_ScrollChanged">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><ui:VirtualizingWrapPanel ItemWidth="{Binding DataContext.GalleryItemWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" ItemHeight="{Binding DataContext.GalleryItemHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            </ListBox>
                        </Grid>

                        <!-- Clicking a cover opens a temporary top-bar tab and focused collection page. -->
                        <Grid Visibility="{Binding IsCollectionDetailView, Converter={StaticResource BoolToVisibility}}" Margin="30,24,30,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="280" Height="280" Margin="0,0,30,0" CornerRadius="14" ClipToBounds="True" Background="{StaticResource SurfaceRaisedBrush}" VerticalAlignment="Top">
                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding SelectedCard.ArtworkPath}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding SelectedCard.ArtworkPath}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                <Image ui:AsyncArtwork.Path="{Binding SelectedCard.ArtworkPath}" ui:AsyncArtwork.DecodePixelWidth="640" ui:AsyncArtwork.Priority="Immediate" Stretch="UniformToFill"/>
                            </Border>
                            <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedCard.Title}" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SelectedCard.Subtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SelectedCard.CountText}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding PlayGroupCommand}" CommandParameter="{Binding SelectedCard}" Content="Play collection" VerticalAlignment="Center"/></Grid>
                                <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource TrackListTemplate}"/>
                            </Grid>
                        </Grid>

                        <!-- Songs and favorites -->
                        <Grid Visibility="{Binding IsTrackView, Converter={StaticResource BoolToVisibility}}" Margin="24,18,24,16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedGroupTitle}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedGroupSubtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding PlaySelectedCommand}" Content="Play selected" VerticalAlignment="Center"/></Grid>
                            <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource TrackListTemplate}"/>
                        </Grid>

                        <!-- Folders and playlists -->
                        <Grid Visibility="{Binding IsSidebarView, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="286"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{Binding CurrentView}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0"/><ListBox x:Name="SidebarList" Grid.Row="1" ItemsSource="{Binding SidebarCards}" ItemTemplate="{StaticResource SidebarCardTemplate}" Background="Transparent" BorderThickness="0" Loaded="SidebarList_Loaded" ScrollViewer.ScrollChanged="SidebarList_ScrollChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ui:SmoothScrollBehavior.Enabled="True"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox></Grid>
                            </Border>
                            <Grid Grid.Column="1" Margin="22,18,24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedGroupTitle}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SelectedGroupSubtitle}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding PlayGroupCommand}" CommandParameter="{Binding SelectedCard}" Content="Play" VerticalAlignment="Center"/></Grid><ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource TrackListTemplate}"/></Grid>
                        </Grid>

                        <!-- Focused now playing -->
                        <Grid Visibility="{Binding IsNowPlayingView, Converter={StaticResource BoolToVisibility}}" Margin="34,24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.95*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                            <Grid Margin="0,0,26,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Width="420" Height="420" MaxWidth="470" MaxHeight="470" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="22" ClipToBounds="True" Background="{StaticResource SurfaceRaisedBrush}" Effect="{StaticResource SoftShadow}"><Grid><TextBlock Text="DEXTROMETHORPHAN" FontSize="18" Foreground="#28FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image ui:AsyncArtwork.Path="{Binding CurrentArtworkPath}" ui:AsyncArtwork.DecodePixelWidth="900" ui:AsyncArtwork.Priority="Immediate" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Row="1" Margin="12,22,12,0"><TextBlock Text="{Binding CurrentTitle}" FontSize="25" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CurrentArtist}" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" Margin="0,5,0,0"/><TextBlock Text="{Binding CurrentTrack.QualityText}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,7,0,0" TextAlignment="Center"/></StackPanel></Grid>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                                <Grid>
                                    <Image ui:AsyncArtwork.Path="{Binding CurrentArtworkPath}" ui:AsyncArtwork.DecodePixelWidth="640" ui:AsyncArtwork.Priority="Deferred" Stretch="UniformToFill" Margin="-44" Opacity="0.22" IsHitTestVisible="False" CacheMode="BitmapCache" RenderOptions.BitmapScalingMode="LowQuality"/>
                                    <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#C90B0C10" Offset="0"/><GradientStop Color="#A80B0C10" Offset="0.48"/><GradientStop Color="#ED0B0C10" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                    <Grid Margin="26,22,18,18">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Grid Margin="4,0,8,0"><TextBlock Text="LYRICS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/><TextBlock Text="{Binding LyricsModeText}" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource AccentBrush}"/></Grid>
                                        <ListBox x:Name="LyricsList" Grid.Row="1" ItemsSource="{Binding Lyrics}" Background="Transparent" BorderThickness="0" Margin="0,7,0,4" Padding="0,8,5,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ui:SmoothScrollBehavior.Enabled="True">
                                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate><DataTemplate>
                                                <Button Command="{Binding DataContext.SeekLyricCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="12,9" Margin="0,1" AutomationProperties.Name="{Binding Text}">
                                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/></DataTrigger><DataTrigger Binding="{Binding IsSynced}" Value="False"><Setter Property="Cursor" Value="Arrow"/><Setter Property="IsHitTestVisible" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" RenderTransformOrigin="0,0.5"><TextBlock.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></TextBlock.RenderTransform><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Opacity" Value="0.43"/><Style.Triggers><DataTrigger Binding="{Binding IsPast}" Value="True"><Setter Property="Opacity" Value="0.22"/><Setter Property="FontSize" Value="20"/></DataTrigger><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True"><Setter Property="Opacity" Value="0.78"/></DataTrigger><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                        <TextBlock Grid.Column="1" Text="{Binding TimestampText}" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="14,5,2,0" VerticalAlignment="Top"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Opacity" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True"><Setter Property="Opacity" Value="0.9"/></DataTrigger><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Opacity" Value="0.6"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasLyrics, Converter={StaticResource InverseBoolToVisibility}}"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8D2;" FontSize="30" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/><TextBlock Text="No lyrics found" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/><TextBlock Text="Place an LRC or text lyric beside this track" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                                        <TextBlock Grid.Row="2" Text="{Binding LyricsHintText}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="5,4,0,0" Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Queue inspector -->
                <Border Grid.Column="1" Width="286" Background="#FC101217" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Visibility="{Binding QueueVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
                        <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Queue" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Temporary playing list" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource IconButton}" Command="{Binding UndoQueueCommand}" Content="&#xE7A7;" ToolTip="Undo"/><Button Style="{StaticResource IconButton}" Command="{Binding ClearQueueCommand}" Content="&#xE74D;" ToolTip="Clear"/></StackPanel></Grid>
                        <Grid Grid.Row="1"><ListBox x:Name="QueueList" ItemsSource="{Binding Queue}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True" PreviewMouseLeftButtonDown="QueueList_PreviewMouseLeftButtonDown" PreviewMouseMove="QueueList_PreviewMouseMove" PreviewMouseLeftButtonUp="QueueList_PreviewMouseLeftButtonUp" DragOver="QueueList_DragOver" Drop="QueueList_Drop"><ListBox.ItemTemplate><DataTemplate><Border Margin="8,2" Padding="9" CornerRadius="9" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"><Border.ContextMenu><ContextMenu><MenuItem Header="Play now" Command="{Binding PlacementTarget.Tag.PlayQueueEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><MenuItem Header="Move to play next" Command="{Binding PlacementTarget.Tag.PlayQueueEntryNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><Separator/><MenuItem Header="Remove from queue" Command="{Binding PlacementTarget.Tag.RemoveQueueEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/></ContextMenu></Border.ContextMenu><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><DataTrigger Binding="{Binding IsPlaying}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#12FFFFFF"/></Trigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="7" ClipToBounds="True" Background="{StaticResource SurfaceRaisedBrush}"><Grid><TextBlock Text="♪" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image ui:AsyncArtwork.Path="{Binding ArtworkPath}" ui:AsyncArtwork.DecodePixelWidth="64" ui:AsyncArtwork.Priority="Visible" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" Margin="9,0" VerticalAlignment="Center"><TextBlock Text="{Binding Track.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Track.Artist}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Track.DurationText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Visibility="{Binding HasQueue, Converter={StaticResource InverseBoolToVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8FD;" FontSize="30" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/><TextBlock Text="Your queue is empty" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBlock Text="Play an album, artist, playlist, or track" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Grid>
                        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><TextBlock Text="Ctrl+Z to undo queue changes" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    </Grid>
                </Border>
                <Border Grid.ColumnSpan="2"
                        Width="430"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="14"
                        Padding="18"
                        CornerRadius="14"
                        Background="#FC151820"
                        BorderBrush="#FF343A49"
                        BorderThickness="1"
                        Panel.ZIndex="90"
                        Effect="{StaticResource SoftShadow}"
                        DataContext="{Binding PerformanceOverlay, RelativeSource={RelativeSource AncestorType=Window}}"
                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Performance" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="LOCAL DEVELOPER OVERLAY" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource IconButton}" Command="{Binding ResetCommand}" Content="&#xE777;" ToolTip="Reset overlay counters"/><Button Style="{StaticResource IconButton}" Command="{Binding ToggleCommand}" Content="&#xE8BB;" ToolTip="Close"/></StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Margin="0,14,0,12" Padding="13,11" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                            <StackPanel><TextBlock Text="{Binding HealthTitle}" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold"/><TextBlock Text="{Binding HealthDetail}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                        </Border>
                        <UniformGrid Grid.Row="2" Columns="2">
                            <Border Style="{StaticResource Card}" Margin="0,0,5,5" Padding="11"><StackPanel><TextBlock Text="FRAME TIME" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding FrameTime}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding FrameRate}" Foreground="{StaticResource AccentBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="5,0,0,5" Padding="11"><StackPanel><TextBlock Text="UI-THREAD STALLS" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding UiStalls}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,5,5,5" Padding="11"><StackPanel><TextBlock Text="IMAGE QUEUE" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding ArtworkQueue}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="5,5,0,5" Padding="11"><StackPanel><TextBlock Text="ARTWORK CACHE" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding ArtworkCache}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,5,5,0" Padding="11"><StackPanel><TextBlock Text="MEMORY" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding WorkingSet}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="5,5,0,0" Padding="11"><StackPanel><TextBlock Text="GARBAGE COLLECTIONS" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding GarbageCollections}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                        </UniformGrid>
                        <StackPanel Grid.Row="3" Margin="2,12,2,0"><TextBlock Text="{Binding DiagnosticsStatus}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis"/><TextBlock Text="Ctrl+Shift+F12 toggles this overlay" Foreground="#708290FF" FontSize="9" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                </Border>
                <Border Grid.ColumnSpan="2" Width="390" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" Padding="20" CornerRadius="14" Background="#FA181B23" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Panel.ZIndex="80" Effect="{StaticResource SoftShadow}" Visibility="{Binding DiagnosticsVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Audio diagnostics" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Live signal path" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding ToggleDiagnosticsCommand}" Content="&#xE8BB;" ToolTip="Close"/></Grid>
                        <Border Grid.Row="1" Margin="0,16,0,12" Padding="14" CornerRadius="10" Background="{StaticResource AccentSoftBrush}"><StackPanel><TextBlock Text="{Binding DiagnosticHeadline}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding DiagnosticMode}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Source" Foreground="{StaticResource TextMutedBrush}" Margin="0,5"/><TextBlock Grid.Column="1" Text="{Binding DiagnosticSource}" TextWrapping="Wrap" Margin="0,5"/><TextBlock Grid.Row="1" Text="Output" Foreground="{StaticResource TextMutedBrush}" Margin="0,5"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiagnosticOutput}" TextWrapping="Wrap" Margin="0,5"/><TextBlock Grid.Row="2" Text="Decoder" Foreground="{StaticResource TextMutedBrush}" Margin="0,5"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DiagnosticDecoder}" TextWrapping="Wrap" Margin="0,5"/><TextBlock Grid.Row="3" Text="Buffer" Foreground="{StaticResource TextMutedBrush}" Margin="0,5"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiagnosticBuffer}" Margin="0,5"/></Grid>
                        <TextBlock Grid.Row="3" Text="{Binding DiagnosticReason}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Persistent player -->
            <Border Grid.Row="2" Background="{StaticResource PlayerGradient}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="14,9"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><Button Padding="0" Command="{Binding NavigateCommand}" CommandParameter="Now Playing"><Border Width="56" Height="56" CornerRadius="9" ClipToBounds="True" Background="{StaticResource SurfaceRaisedBrush}"><Image ui:AsyncArtwork.Path="{Binding CurrentArtworkPath}" ui:AsyncArtwork.DecodePixelWidth="96" ui:AsyncArtwork.Priority="Immediate" Stretch="UniformToFill"/></Border></Button><Button Grid.Column="1" Command="{Binding NavigateCommand}" CommandParameter="Now Playing" HorizontalContentAlignment="Left" Padding="8,4"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding CurrentTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding CurrentArtist}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Button><Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding LoveCommand}" Content="{Binding LoveGlyph}" FontFamily="Segoe UI Symbol" FontSize="18" ToolTip="Love"/></Grid>
                    <Grid Grid.Column="1" Margin="18,0"><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Command="{Binding ToggleShuffleCommand}" ToolTip="{Binding ShuffleText}" AutomationProperties.Name="{Binding ShuffleText}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding IsShuffleEnabled}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid Width="40" Height="40"><TextBlock Text="&#xE8B1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Width="4" Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" Visibility="{Binding IsShuffleEnabled, Converter={StaticResource BoolToVisibility}}"/></Grid></Button><Button Style="{StaticResource IconButton}" Command="{Binding PreviousCommand}" Content="&#xE892;" ToolTip="Previous"/><Button Style="{StaticResource PrimaryTransportButton}" Command="{Binding TogglePlaybackCommand}" Content="{Binding PlayGlyph}"/><Button Style="{StaticResource IconButton}" Command="{Binding NextCommand}" Content="&#xE893;" ToolTip="Next"/><Button Command="{Binding CycleRepeatCommand}" ToolTip="{Binding RepeatText}" AutomationProperties.Name="{Binding RepeatText}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding IsRepeatEnabled}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style><Grid Width="40" Height="40"><TextBlock Text="&#xE8EE;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border Width="13" Height="13" CornerRadius="7" Background="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Visibility="{Binding IsRepeatOne, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="1" Foreground="#FF0B0C10" FontFamily="Segoe UI" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Width="4" Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" Visibility="{Binding IsRepeatEnabled, Converter={StaticResource BoolToVisibility}}"/></Grid></Button></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock Text="{Binding PositionText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/><Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}" PreviewMouseLeftButtonDown="SeekSlider_MouseLeftButtonDown" PreviewMouseMove="SeekSlider_MouseMove" PreviewMouseLeftButtonUp="SeekSlider_MouseLeftButtonUp"/><TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></Grid>
                    <Grid Grid.Column="2" Margin="20,0,2,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE767;" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/><Slider x:Name="VolumeSlider" Grid.Column="1" Margin="10,0,0,0" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" PreviewMouseLeftButtonDown="VolumeSlider_MouseLeftButtonDown" PreviewMouseMove="VolumeSlider_MouseMove" PreviewMouseLeftButtonUp="VolumeSlider_MouseLeftButtonUp"/></Grid>
                </Grid>
            </Border>

            <!-- Lightweight in-window startup presentation. It covers initialization, then yields in under a second. -->
            <Grid x:Name="StartupOverlay" Grid.RowSpan="3" Panel.ZIndex="1000" Background="#FF0B0C10">
                <StackPanel x:Name="StartupBrand" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></StackPanel.RenderTransform>
                    <Grid Width="154" Height="154" HorizontalAlignment="Center">
                        <Ellipse x:Name="StartupOrbit" Width="148" Height="148" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" StrokeDashArray="1,8" Opacity="0.42" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform></Ellipse>
                        <Border Width="126" Height="126" CornerRadius="38" Background="#78181B23" BorderBrush="#2FFFFFFF" BorderThickness="1" Effect="{StaticResource SoftShadow}"><Image Source="Assets/Brand/dextromethorphan-symbol-compact.png" Margin="17" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                    </Grid>
                    <TextBlock Text="dextromethorphan" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    <TextBlock Text="M U S I C   P L A Y E R" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                    <Border Width="54" Height="2" CornerRadius="1" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
