                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Style.Triggers><DataTrigger Binding="{Binding ActiveToast.Severity}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding ActiveToast.Severity}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding ActiveToast.Severity}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding ActiveToast.Message}" FontSize="12" VerticalAlignment="Center" AutomationProperties.Name="{Binding ActiveToast.AutomationText}" ui:LiveRegionBehavior.Announcement="{Binding ActiveToast}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="AutomationProperties.LiveSetting" Value="Polite"/><Style.Triggers><DataTrigger Binding="{Binding ActiveToast.Severity}" Value="Error"><Setter Property="AutomationProperties.LiveSetting" Value="Assertive"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="2" Width="30" Height="30" Margin="10,0,0,0" Content="&#xE711;" Command="{Binding DismissNoticeCommand}" ToolTip="Dismiss notification" AutomationProperties.Name="Dismiss notification">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource IconButton}"><Style.Triggers><DataTrigger Binding="{Binding ActiveToast.Severity}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding ActiveToast.Severity}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding ActiveToast.Severity}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </Grid>
            </Border>

            <Grid x:Name="DropOverlay" Grid.RowSpan="3" Panel.ZIndex="950" Background="#D90B0C10" Visibility="Collapsed" IsHitTestVisible="False">
                <Border Width="460" Padding="30" CornerRadius="18" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource SoftShadow}">
                    <StackPanel><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" FontSize="42" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/><TextBlock Text="Drop music here" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/><TextBlock x:Name="DropOverlayHint" Text="Folders become library sources; audio files open in the queue." Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                </Border>
            </Grid>

            <!-- Lightweight in-window startup presentation. It covers initialization, then yields in under a second. -->
            <Grid x:Name="StartupOverlay" Grid.RowSpan="3" Panel.ZIndex="1000" Background="{DynamicResource BackgroundBrush}">
                <StackPanel x:Name="StartupBrand" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform><ScaleTransform ScaleX="0.9" ScaleY="0.9"/></StackPanel.RenderTransform>
                    <Grid Width="154" Height="154" HorizontalAlignment="Center">
                        <Ellipse x:Name="StartupOrbit" Width="148" Height="148" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeDashArray="1,8" Opacity="0.42" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform></Ellipse>
                        <Border Width="126" Height="126" CornerRadius="38" Background="#78181B23" BorderBrush="#2FFFFFFF" BorderThickness="1" Effect="{StaticResource SoftShadow}"><Image Source="Assets/Brand/dextromethorphan-symbol-compact.png" Margin="17" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                    </Grid>
                    <TextBlock Text="dextromethorphan" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    <TextBlock Text="M U S I C   P L A Y E R" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                    <Border Width="54" Height="2" CornerRadius="1" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
