<UserControl x:Class="Dextromethorphan.App.UI.Controls.StatePresenter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Dextromethorphan.App.UI.Controls"
             xmlns:ui="clr-namespace:Dextromethorphan.App.UI"
             x:Name="Root"
             Focusable="False"
             IsTabStop="False"
             AutomationProperties.Name="{Binding AccessibleName, ElementName=Root}"
             ui:LiveRegionBehavior.Announcement="{Binding AccessibleName, ElementName=Root}">
    <Border x:Name="StateSurface"
            MaxWidth="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="24"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                        <Setter Property="Padding" Value="16"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel HorizontalAlignment="Center">
            <Border x:Name="GlyphSurface"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource SurfaceRaisedBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="48"/>
                        <Setter Property="Height" Value="48"/>
                        <Setter Property="CornerRadius" Value="24"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Loading">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Offline">
                                <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Error">
                                <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Success">
                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                <Setter Property="Width" Value="40"/>
                                <Setter Property="Height" Value="40"/>
                                <Setter Property="CornerRadius" Value="20"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock x:Name="StateGlyph"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE946;"/>
                            <Setter Property="FontSize" Value="22"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Loading">
                                    <Setter Property="Text" Value="&#xE895;"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Empty">
                                    <Setter Property="Text" Value="&#xE8B7;"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Offline">
                                    <Setter Property="Text" Value="&#xEB5A;"/>
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Error">
                                    <Setter Property="Text" Value="&#xEA39;"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Disabled">
                                    <Setter Property="Text" Value="&#xE72E;"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind, ElementName=Root}" Value="Success">
                                    <Setter Property="Text" Value="&#xE73E;"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                                    <Setter Property="FontSize" Value="18"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
            <TextBlock Text="{Binding Title, ElementName=Root}"
                       Margin="0,14,0,0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Description, ElementName=Root}"
                       MaxWidth="400"
                       Margin="0,5,0,0"
                       FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Description, ElementName=Root}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Description, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Content="{Binding ActionText, ElementName=Root}"
                    Command="{Binding ActionCommand, ElementName=Root}"
                    CommandParameter="{Binding ActionCommandParameter, ElementName=Root}"
                    Margin="0,15,0,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="{Binding ActionText, ElementName=Root}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActionText, ElementName=Root}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ActionText, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
    <UserControl.Style>
        <Style TargetType="controls:StatePresenter">
            <Style.Triggers>
                <Trigger Property="Kind" Value="Disabled">
                    <Setter Property="Opacity" Value="0.72"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
</UserControl>
