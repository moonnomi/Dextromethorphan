<UserControl x:Class="Dextromethorphan.App.UI.Views.PerformanceDiagnosticsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Focusable="False">
<Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Performance" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="LOCAL DEVELOPER OVERLAY" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource IconButton}" Command="{Binding ResetCommand}" Content="&#xE777;" ToolTip="Reset overlay counters" AutomationProperties.Name="Reset performance counters"/><Button Style="{StaticResource IconButton}" Command="{Binding ToggleCommand}" Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close diagnostics"/></StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Margin="0,14,0,12" Padding="13,11" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                            <StackPanel><TextBlock Text="{Binding HealthTitle}" Foreground="{DynamicResource AccentBrush}" FontSize="13" FontWeight="Bold"/><TextBlock Text="{Binding HealthDetail}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                        </Border>
                        <UniformGrid Grid.Row="2" Columns="2">
                            <Border Style="{StaticResource Card}" Margin="0,0,5,5" Padding="11"><StackPanel><TextBlock Text="FRAME TIME" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding FrameTime}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/><TextBlock Text="{Binding FrameRate}" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="5,0,0,5" Padding="11"><StackPanel><TextBlock Text="UI-THREAD STALLS" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding UiStalls}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,5,5,5" Padding="11"><StackPanel><TextBlock Text="IMAGE QUEUE" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding ArtworkQueue}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="5,5,0,5" Padding="11"><StackPanel><TextBlock Text="ARTWORK CACHE" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding ArtworkCache}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,5,5,0" Padding="11"><StackPanel><TextBlock Text="MEMORY" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding WorkingSet}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="5,5,0,0" Padding="11"><StackPanel><TextBlock Text="GARBAGE COLLECTIONS" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding GarbageCollections}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                        </UniformGrid>
                        <StackPanel Grid.Row="3" Margin="2,12,2,0"><TextBlock Text="{Binding DiagnosticsStatus}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis"/><TextBlock Text="Ctrl+Shift+F12 toggles this overlay" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
</UserControl>
