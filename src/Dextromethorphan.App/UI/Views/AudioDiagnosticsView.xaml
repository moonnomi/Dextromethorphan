<UserControl x:Class="Dextromethorphan.App.UI.Views.AudioDiagnosticsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="clr-namespace:Dextromethorphan.App.UI"
 Focusable="False">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Audio diagnostics" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Live signal path" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource IconButton}" Command="{Binding ToggleDiagnosticsCommand}" Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close diagnostics"/></Grid>
                        <Border Grid.Row="1" Margin="0,16,0,12" Padding="14" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}"><StackPanel><TextBlock Text="{Binding DiagnosticHeadline}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding DiagnosticMode}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
                        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Source" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5"/><TextBlock Grid.Column="1" Text="{Binding DiagnosticSource}" TextWrapping="Wrap" Margin="0,5"/><TextBlock Grid.Row="1" Text="Output" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiagnosticOutput}" TextWrapping="Wrap" Margin="0,5"/><TextBlock Grid.Row="2" Text="Decoder" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DiagnosticDecoder}" TextWrapping="Wrap" Margin="0,5"/><TextBlock Grid.Row="3" Text="Buffer" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiagnosticBuffer}" Margin="0,5"/><TextBlock Grid.Row="4" Text="Endpoint" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DiagnosticEndpoint}" TextWrapping="Wrap" Margin="0,5"/><TextBlock Grid.Row="5" Text="Health" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DiagnosticTiming}" TextWrapping="Wrap" Margin="0,5"/></Grid>
                        <TextBlock Grid.Row="3" Text="{Binding DiagnosticReason}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        <StackPanel Grid.Row="2" Margin="0,6,0,12">
                            <ui:OutputProbeGraph Diagnostics="{Binding OutputProbe}" Height="300" AutomationProperties.Name="Live outgoing, incoming and output RMS history"/>
                            <TextBlock Text="Measured after gain, fades and PCM conversion, before WASAPI. This is not a speaker or loopback recording. Outgoing/incoming lanes show weighted mixer contributions before final DSP." TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0"/>
                            <TextBlock Text="Export diagnostics after a transition to include the measured frame counts and levels." TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid></ScrollViewer>
</UserControl>
