<Window x:Class="Dextromethorphan.App.DatabaseRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library recovery"
        Width="610"
        SizeToContent="Height"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.Name="Library recovery dialog">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="28">
        <StackPanel>
            <TextBlock Text="The library database needs recovery"
                       FontSize="23"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="DetailText"
                       Margin="0,10,0,22"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"/>
            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Restore latest automatic backup"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="BackupText"
                               Margin="0,4,0,12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                    <Button x:Name="RestoreButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="_Restore backup"
                            AutomationProperties.Name="Restore latest automatic backup"
                            AutomationProperties.HelpText="Restores app data from the newest available automatic backup without modifying music files."
                            HorizontalAlignment="Left"
                            Click="Restore_Click"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}"
                    Padding="16"
                    Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Rebuild from configured music folders"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="The damaged database is quarantined. Recoverable ratings, love state, play history, bookmarks, and playlists are saved separately and reapplied after a fresh read-only scan of your audio files."
                               Margin="0,4,0,12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"/>
                    <Button Content="Re_build library"
                            AutomationProperties.Name="Rebuild library"
                            AutomationProperties.HelpText="Quarantines the damaged database and rebuilds the library by reading configured music folders."
                            HorizontalAlignment="Left"
                            Click="Rebuild_Click"/>
                </StackPanel>
            </Border>
            <Button Content="E_xit without changing data"
                    IsCancel="True"
                    AutomationProperties.Name="Exit without changing data"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0"
                    Click="Exit_Click"/>
        </StackPanel>
    </Border>
</Window>
