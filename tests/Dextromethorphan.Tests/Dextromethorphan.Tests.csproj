<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Dextromethorphan.App/Dextromethorphan.App.csproj" />
    <ProjectReference Include="../../src/Dextromethorphan.Core/Dextromethorphan.Core.csproj" />
    <ProjectReference Include="../../src/Dextromethorphan.Infrastructure/Dextromethorphan.Infrastructure.csproj" />
    <ProjectReference Include="../../tools/Dextromethorphan.PerformanceFixtures/Dextromethorphan.PerformanceFixtures.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="../Fixtures/AudioFormats/**">
      <Link>Fixtures/AudioFormats/%(RecursiveDir)%(Filename)%(Extension)</Link>
